{
  "notch": {
    "shape": "floating",
    "opacity": 1.0,
    "radius": 16,
    "height": 34,
    "gap": 6
  },
  "workspaces": {
    "count": 4
  },
  "weather": {
    "location": "",
    "lat": 0,
    "lon": 0,
    "refreshMin": 20
  },
  "wallpaper": {
    "dir": "~/Pictures/wallpapers",
    "transitionMs": 600
  },
  "theme": {
    "tint": 0.15
  },
  "apps": {
    "dir": "~/apps"
  },
  "quicklinks": "~/.config/torii/quicklinks.json",
  "font": {
    "family": "JetBrainsMono Nerd Font",
    "size": 13
  },
  "automove": {
    "from": "~/Downloads",
    "to": "/mnt/mass/Media_MASS/Photo/inbox",
    "unzipDir": "_"
  },
  "launcher": {
    "rememberBack": true,
    "rememberForward": false,
    "menuHistory": true,
    "placeholder": "Search apps  \u00b7  \u2193 opens the menus"
  },
  "notifications": {
    "expand": "side"
  },
  "sounds": {
    "notification": "waterdrop.ogg"
  }
}

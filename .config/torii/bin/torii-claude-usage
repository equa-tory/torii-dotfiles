#!/usr/bin/env python3
"""Prints {"pct": 0-100, "resets": iso, "week": 0-100} for the logged-in Claude account, or {} when not signed in.
Read-only: it never refreshes the token (that would rotate it under a running Claude Code)."""
import json, os, sys, time, urllib.request

try:
    c = json.load(open(os.path.expanduser("~/.claude/.credentials.json")))["claudeAiOauth"]
    if c.get("expiresAt", 0) / 1000 < time.time():
        raise ValueError("expired")
    req = urllib.request.Request("https://api.anthropic.com/api/oauth/usage", headers={
        "Authorization": "Bearer " + c["accessToken"], "anthropic-beta": "oauth-2025-04-20",
        "User-Agent": "torii-shell"})
    d = json.load(urllib.request.urlopen(req, timeout=10))
    h, w = d.get("five_hour") or {}, d.get("seven_day") or {}
    print(json.dumps({"pct": h.get("utilization", 0), "resets": h.get("resets_at", ""),
                      "week": w.get("utilization", 0)}))
except Exception as e:
    print("{}")
    print(f"torii-claude-usage: {e}", file=sys.stderr)

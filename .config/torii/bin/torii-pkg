#!/usr/bin/env bash
# torii-pkg add|remove [--aur] <pkg...>   install/remove packages AND keep packages/{pacman,aur}.txt in step,
# so a fresh ./install.sh brings back the same set. Also: torii-pkg list-missing (installed but not in the lists).
set -euo pipefail

REPO="${TORII_REPO:-$HOME/torii-dotfiles}"
PAC="$REPO/packages/pacman.txt"; AUR="$REPO/packages/aur.txt"
[[ -f $PAC && -f $AUR ]] || { echo "torii-pkg: no dotfiles repo at $REPO (set TORII_REPO)" >&2; exit 1; }

in_list() { grep -qxF "$2" "$1"; }
add_line() { in_list "$1" "$2" || { [[ -n $(tail -c1 "$1") ]] && echo >> "$1"; echo "$2" >> "$1"; }; }
del_line() { sed -i "/^$(printf '%s' "$2" | sed 's/[][\.*^$/]/\\&/g')\$/d" "$1"; }
is_repo_pkg() { pacman -Si "$1" >/dev/null 2>&1; }

cmd="${1:-}"; shift || true
force_aur=0; [[ ${1:-} == --aur ]] && { force_aur=1; shift; }

case "$cmd" in
  add)
    (($#)) || { echo "usage: torii-pkg add [--aur] <pkg...>"; exit 2; }
    for p in "$@"; do
      if ((force_aur == 0)) && is_repo_pkg "$p"; then
        sudo pacman -S --needed "$p" && add_line "$PAC" "$p"
      else
        yay -S --needed "$p" && add_line "$AUR" "$p"
      fi
    done ;;
  remove)
    (($#)) || { echo "usage: torii-pkg remove <pkg...>"; exit 2; }
    for p in "$@"; do
      if in_list "$AUR" "$p"; then yay -Rns "$p" && del_line "$AUR" "$p"
      else sudo pacman -Rns "$p" && del_line "$PAC" "$p"; fi
    done ;;
  list-missing)
    pacman -Qqe | grep -vxFf <(grep -vE '^\s*(#|$)' "$PAC" "$AUR" | sed 's/^[^:]*://') || true ;;
  *) echo "usage: torii-pkg add [--aur] <pkg...> | remove <pkg...> | list-missing"; exit 2 ;;
esac

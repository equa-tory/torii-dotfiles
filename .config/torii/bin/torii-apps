#!/usr/bin/env python3
"""torii-apps list | generate | desktop | run <folder>  -  mac-style apps for the launcher.

Every folder directly inside ~/apps (apps.dir in ~/.config/torii/config.json) is an app. It is described by a .desktop
file inside that folder (~/apps/v2rayN/v2rayN.desktop) or by an app.json:

  ~/apps/foo/app.json
  { "name": "Foo", "exec": "bin/foo", "icon": "icon.png", "keywords": ["x"], "description": "..." }
  { "name": "Notepad++", "bottle": "Soft", "program": "npp.exe" }      a Windows program run by Bottles

  list      JSON array for the launcher. Folders without either file get a .desktop first (generate)
  generate  look for the program in a folder that has no description yet (an executable named like the folder, at most two
            levels down) and write <folder>/<program>.desktop for it, with its icon. Existing files are never touched.
  desktop   copy these apps to ~/.local/share/applications/torii-app-*.desktop so other launchers and xdg-open see them
  run       start one by folder name (used by those entries)
  webapp add [--browser] [--own] <name> <url> | remove <name> | set <name> browser|own true|false | list | sync
            web apps: a Helium window without browser chrome (--app=URL); "browser" opens a tab in the default browser instead;
            "own" gives it a browser process and profile of its own (sign in once more), so its sound is a separate stream
            (screen recording can then put it on its own track)
  tui add [--quiet] <name> <command> | remove <name> | set <name> quiet true|false | list | sync
            terminal programs as apps (e.g. dorm = ssh 192.168.1.50); "quiet" runs the command in the background with no
            window (output in ~/.local/state/torii/tui-<name>.log) and a notification when it is done
            Both lists live in ~/.local/state/torii/{webapps,tuis}.json (private data, not in the dotfiles repo; the
            home-server sync carries them). `sync` rewrites the .desktop files from those lists.
Nothing is moved or installed: the folders stay exactly where they are.
"""
import json
import os
import re
import shlex
import shutil
import sys
from pathlib import Path

ICON_EXT = (".png", ".svg", ".xpm")


def apps_dir():
    try:
        cfg = json.loads((Path.home() / ".config/torii/config.json").read_text())
        d = cfg.get("apps", {}).get("dir", "~/apps")
    except (OSError, ValueError):
        d = "~/apps"
    return Path(os.path.expanduser(d))


def folders():
    root = apps_dir()
    return sorted(p for p in root.iterdir() if p.is_dir() and not p.name.startswith(".")) if root.is_dir() else []


# ---------------------------------------------------------------- generate
def is_program(p):
    try:
        if not p.is_file() or not os.access(p, os.X_OK) or p.suffix.lower() in (".so", ".png", ".icns", ".svg", ".json", ".txt", ".dll"):
            return False
        with open(p, "rb") as f:
            head = f.read(4)
        return head.startswith(b"\x7fELF") or head.startswith(b"#!")
    except OSError:
        return False


def find_program(folder):
    token = re.split(r"[-_ .]", folder.name.lower())[0]
    found = []
    for depth_glob in ("*", "*/*"):
        for p in folder.glob(depth_glob):
            if is_program(p) and p.name.lower().startswith(token):
                found.append(p)
    # the biggest one is the real program (not a helper that happens to share the prefix)
    return max(found, key=lambda p: p.stat().st_size) if found else None


def find_icon(folder, program):
    stem = program.stem.lower()
    best = None
    for p in list(folder.glob("*")) + list(folder.glob("*/*")):
        if p.suffix.lower() in ICON_EXT and p.stem.lower().startswith(stem[:4]):
            if best is None or p.suffix.lower() == ".png" and best.suffix.lower() != ".png":
                best = p
    return str(best) if best else "application-x-executable"


def quote(path):
    s = str(path)
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"' if re.search(r'[\s"\'\\$`]', s) else s


def generate():
    made = []
    for d in folders():
        if (d / "app.json").is_file() or list(d.glob("*.desktop")):
            continue
        prog = find_program(d)
        if not prog:
            continue
        out = d / (prog.stem + ".desktop")
        out.write_text(
            "[Desktop Entry]\nType=Application\nVersion=1.0\n"
            f"Name={prog.stem}\nComment=App from {d.parent.name}/{d.name}\nIcon={find_icon(d, prog)}\n"
            f"Path={prog.parent}\nExec={quote(prog)}\nTerminal=false\nCategories=Utility;\n")
        made.append(str(out))
    return made


# ---------------------------------------------------------------- scan
def read_desktop(f):
    keys, in_entry = {}, False
    try:
        for line in f.read_text(errors="replace").splitlines():
            if line.startswith("["):
                in_entry = line.strip() == "[Desktop Entry]"
            elif in_entry and "=" in line and not line.startswith("#"):
                k, _, v = line.partition("=")
                keys.setdefault(k.strip(), v.strip())
    except OSError:
        return None
    if keys.get("NoDisplay", "").lower() == "true" or keys.get("Hidden", "").lower() == "true":
        return None
    cmd = keys.get("Exec", "")
    cmd = re.sub(r"\s%[a-zA-Z]", "", cmd).replace("%%", "%").strip()
    return {"name": keys.get("Name") or f.stem, "exec": cmd, "icon": keys.get("Icon", ""), "dir": keys.get("Path", ""),
            "keywords": [k for k in keys.get("Keywords", "").split(";") if k], "description": keys.get("Comment", "")}


def scan():
    out = []
    for d in folders():
        entries = []
        for f in sorted(d.glob("*.desktop")):
            e = read_desktop(f)
            if e and e["exec"]:
                entries.append(e)
        manifest = d / "app.json"
        if not entries and manifest.is_file():
            try:
                m = json.loads(manifest.read_text())
            except (OSError, ValueError):
                m = None
            if isinstance(m, dict):
                if m.get("bottle") and m.get("program"):
                    ex = "bottles-cli run -b '%s' -p '%s'" % (m["bottle"], m["program"])
                elif m.get("exec"):
                    ex = m["exec"]
                    ex = " ".join(ex) if isinstance(ex, list) else str(ex)
                else:
                    ex = ""
                if ex:
                    # a terminal app gets its own window class (torii-app-<name>) so App rules can tell cliamp from lava lamp
                    nm = str(m.get("name") or d.name)
                    if re.match(r"kitty(\s|$)", ex) and "--class" not in ex:
                        ex = "kitty --class torii-app-%s %s" % (re.sub(r"[^a-z0-9]+", "-", nm.lower()).strip("-"), ex[5:].strip())
                    icon = str(m.get("icon", ""))
                    if icon and (d / icon).is_file():
                        icon = str(d / icon)
                    entries.append({"name": str(m.get("name") or d.name), "exec": ex, "icon": icon, "dir": "",
                                    "keywords": [str(k) for k in m.get("keywords", []) if isinstance(k, (str, int))],
                                    "description": str(m.get("description", ""))})
        for e in entries:
            icon = e["icon"]
            if icon and not icon.startswith("/") and (d / icon).is_file():
                icon = str(d / icon)
            out.append({**e, "icon": icon, "dir": e["dir"] or str(d), "folder": d.name})
    return out


def dq(arg):
    """one argument of a .desktop Exec line (double quotes, not the shell's single quotes)"""
    if re.fullmatch(r"[A-Za-z0-9_./:+@%-]+", arg):
        return arg
    return '"' + arg.replace("\\", "\\\\").replace('"', '\\"').replace("$", "\\$").replace("`", "\\`") + '"'


def desktop_sync():
    """~/.local/share/applications/torii-app-<name>.desktop for every app; entries of apps that are gone are removed."""
    target = Path.home() / ".local/share/applications"
    target.mkdir(parents=True, exist_ok=True)
    keep = set()
    for a in scan():
        slug = re.sub(r"[^a-z0-9]+", "-", a["name"].lower()).strip("-") or "app"
        f = target / f"torii-app-{slug}.desktop"
        keep.add(f.name)
        f.write_text(
            "[Desktop Entry]\nType=Application\nVersion=1.0\n"
            f"Name={a['name']}\nComment={a['description'] or 'App from ~/apps'}\nIcon={a['icon'] or 'application-x-executable'}\n"
            f"Path={a['dir']}\nExec={Path.home()}/.config/torii/bin/torii-apps run {dq(a['folder'])} {dq(a['name'])}\nTerminal=false\n"
            f"Keywords={';'.join(a['keywords'])};\nX-Torii-App=true\n")
    for old in target.glob("torii-app-*.desktop"):
        if old.name not in keep:
            old.unlink()
    return len(keep)


def open_entry(desk_id):
    """Start an installed .desktop entry. Terminal=true entries (cliamp, htop, ...) are run in kitty by us: handing them to
    uwsm / xdg-terminal-exec opens a kitty "Open URL error" window with `%`. Everything else goes through uwsm app."""
    desk_id = desk_id if desk_id.endswith(".desktop") else desk_id + ".desktop"
    dirs = [Path.home() / ".local/share/applications"] + [Path(d) / "applications" for d in
            os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")]
    f = next((d / desk_id for d in dirs if (d / desk_id).is_file()), None)
    uwsm = os.environ.get("UWSM_FINALIZE_VARNAMES") is not None or shutil.which("uwsm")
    wrap = ["uwsm", "app", "--"] if uwsm else []
    entry = {}
    if f:
        for line in f.read_text(errors="replace").splitlines():
            if line.startswith("["):
                if entry: break
                continue
            k, _, v = line.partition("=")
            entry.setdefault(k, v)
    if f and entry.get("Terminal", "").lower() == "true" and entry.get("Exec"):
        argv = [w for w in shlex.split(entry["Exec"]) if not re.fullmatch(r"%[a-zA-Z%]", w)]
        cls = "torii-app-" + re.sub(r"[^a-z0-9]+", "-", desk_id[:-8].lower()).strip("-")
        os.execvp(wrap[0] if wrap else "kitty", wrap + ["kitty", "--class", cls, "--title", entry.get("Name", argv[0]), "-e"] + argv)
    os.execvp(wrap[0] if wrap else "gtk-launch", wrap + [desk_id] if wrap else ["gtk-launch", desk_id])


# ---------------------------------------------------------------- web apps and terminal apps
STATE = Path(os.environ.get("TORII_STATE", Path.home() / ".local/state/torii"))


def slug(name):
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-") or "app"


def load_list(name):
    try:
        data = json.loads((STATE / name).read_text())
        return data if isinstance(data, list) else []
    except (OSError, ValueError):
        return []


def save_list(name, items):
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = (STATE / name).with_suffix(".tmp")
    tmp.write_text(json.dumps(items, indent=2) + "\n")
    os.replace(tmp, STATE / name)


def favicon(url, name):
    """Site icon next to the other user icons; the theme's web icon when it cannot be fetched."""
    import subprocess
    from urllib.parse import urlparse
    host = urlparse(url if "://" in url else "https://" + url).netloc
    dest = Path.home() / ".local/share/icons/torii-web" / f"{slug(name)}.png"
    if dest.is_file():
        return str(dest)
    dest.parent.mkdir(parents=True, exist_ok=True)
    r = subprocess.run(["curl", "-fsSL", "-m", "8", "-o", str(dest), f"https://www.google.com/s2/favicons?domain={host}&sz=128"],
                       capture_output=True)
    if r.returncode != 0 or not dest.is_file() or dest.stat().st_size < 100:
        dest.unlink(missing_ok=True)
        return "web-browser"
    return str(dest)


def sync_web():
    target = Path.home() / ".local/share/applications"
    target.mkdir(parents=True, exist_ok=True)
    keep = set()
    for w in load_list("webapps.json"):
        url = w["url"] if "://" in w["url"] else "https://" + w["url"]
        from urllib.parse import urlparse
        u = urlparse(url)
        f = target / f"torii-web-{slug(w['name'])}.desktop"
        keep.add(f.name)
        if w.get("browser"):
            exec_line = f"Exec=xdg-open {url}\n"
            wm = ""
        else:
            prof = f"--user-data-dir={Path.home()}/.local/share/torii/webapp/{slug(w['name'])} " if w.get("own") else ""
            exec_line = f"Exec=helium-browser {prof}--app={url}\n"
            wm = f"StartupWMClass=chrome-{u.netloc}_{(u.path or '/').replace('/', '_')}-Default\n"
        f.write_text("[Desktop Entry]\nType=Application\nVersion=1.0\n"
                     f"Name={w['name']}\nComment=Web app\nIcon={favicon(url, w['name'])}\n"
                     f"{exec_line}Terminal=false\nCategories=Network;\n{wm}"
                     "X-Torii-Web=true\n")
    for old in target.glob("torii-web-*.desktop"):
        if old.name not in keep:
            old.unlink()


# apps started from the launcher do not get ~/.local/bin (claude, pipx and cargo tools live there)
PATH_FIX = 'export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"\n'


def sync_tui():
    root = apps_dir()
    keep = set()
    for t in load_list("tuis.json"):
        d = root / slug(t["name"])
        d.mkdir(parents=True, exist_ok=True)
        f = d / f"{slug(t['name'])}.desktop"
        keep.add(f)
        run = d / "run.sh"
        if t.get("quiet"):
            log = STATE / f"tui-{slug(t['name'])}.log"
            run.write_text("#!/bin/sh\n" + PATH_FIX +
                           f"sh -c {shlex.quote(t['command'])} >{shlex.quote(str(log))} 2>&1 </dev/null\n"
                           "code=$?\n"
                           f"if [ $code = 0 ]; then notify-send -a torii {shlex.quote(t['name'])} done 2>/dev/null\n"
                           f"else a=$(notify-send -a torii -A default='Show the log' -w {shlex.quote(t['name'])} \"failed ($code), click to see the log\" 2>/dev/null)\n"
                           f"  [ \"$a\" = default ] && exec kitty --title {shlex.quote(t['name'] + ' log')} sh -c 'cat \"$1\"; printf \"\\n[Enter to close] \"; read _' sh {shlex.quote(str(log))}\n"
                           "fi\n")
            exec_line = f"Exec=sh {run}\n"
        else:
            run.write_text("#!/bin/sh\n" + PATH_FIX + t["command"] + "\nprintf '\\n[done, Enter to close] '\nread _\n")
            exec_line = f"Exec=kitty --title {shlex.quote(t['name'])} {run}\n"
        run.chmod(0o755)
        f.write_text("[Desktop Entry]\nType=Application\nVersion=1.0\n"
                     f"Name={t['name']}\nComment=TUI: {t['command']}\nIcon=utilities-terminal\n"
                     f"{exec_line}Terminal=false\nX-Torii-Tui=true\n")
    for old in root.glob("*/*.desktop") if root.is_dir() else []:
        if "X-Torii-Tui=true" in old.read_text(errors="replace") and old not in keep:
            old.unlink()
            (old.parent / "run.sh").unlink(missing_ok=True)
            try:
                old.parent.rmdir()
            except OSError:
                pass


def lists(kind, a):
    name = {"webapp": "webapps.json", "tui": "tuis.json"}[kind]
    key = "url" if kind == "webapp" else "command"
    items = load_list(name)
    if a[:1] == ["list"]:
        print(json.dumps(items))
        return
    opts = ("browser", "own") if kind == "webapp" else ("quiet",)
    if a[:1] == ["add"] and len(a) >= 3:
        flags = []
        while len(a) > 3 and a[1].startswith("--") and a[1][2:] in opts:
            flags.append(a[1][2:])
            a = a[:1] + a[2:]
        item = {"name": a[1], key: " ".join(a[2:])}
        for f in flags:
            item[f] = True
        items = [i for i in items if i["name"].lower() != a[1].lower()] + [item]
        save_list(name, items)
    elif a[:1] == ["set"] and len(a) == 4 and a[2] in opts:
        opt = a[2]
        for i in items:
            if i["name"].lower() == a[1].lower():
                i[opt] = a[3] == "true"
        save_list(name, items)
    elif a[:1] == ["remove"] and len(a) == 2:
        save_list(name, [i for i in items if i["name"].lower() != a[1].lower()])
    elif a[:1] != ["sync"]:
        sys.exit(__doc__)
    (sync_web if kind == "webapp" else sync_tui)()


if __name__ == "__main__":
    a = sys.argv[1:]
    if a[:1] in (["webapp"], ["tui"]):
        lists(a[0], a[1:])
        sys.exit(0)
    if a == ["list"]:
        generate()
        print(json.dumps(scan()))
    elif a == ["generate"]:
        print("\n".join(generate()))
    elif a == ["desktop"]:
        generate()
        print(desktop_sync())
    elif a[:1] == ["open"] and len(a) == 2:
        open_entry(a[1])
    elif a[:1] == ["run"] and len(a) in (2, 3):
        for app in scan():
            if app["folder"] == a[1] and (len(a) == 2 or app["name"] == a[2]):
                os.chdir(app["dir"])
                os.execvp("sh", ["sh", "-c", 'PATH="$PWD:$PATH"; exec ' + app["exec"]])
        sys.exit("no app named " + " ".join(a[1:]))
    else:
        print(__doc__)
        sys.exit(2)

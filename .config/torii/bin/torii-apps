#!/usr/bin/env python3
"""torii-apps list | generate | desktop | run <folder>  -  mac-style apps for the launcher.

Every folder directly inside ~/apps (apps.dir in ~/.config/torii/config.json) is an app. It is described by a .desktop
file inside that folder (~/apps/v2rayN/v2rayN.desktop) or by an app.json:

  ~/apps/foo/app.json
  { "name": "Foo", "exec": "bin/foo", "icon": "icon.png", "keywords": ["x"], "description": "..." }
  { "name": "Notepad++", "bottle": "Soft", "program": "npp.exe" }      a Windows program run by Bottles

  list      JSON array for the launcher. Folders without either file get a .desktop first (generate)
  generate  look for the program in a folder that has no description yet (an executable named like the folder, at most two
            levels down) and write <folder>/<program>.desktop for it, with its icon. Existing files are never touched.
  desktop   copy these apps to ~/.local/share/applications/torii-app-*.desktop so other launchers and xdg-open see them
  run       start one by folder name (used by those entries)
  webapp add <name> <url> | remove <name> | list | sync    web apps: a Helium window without browser chrome (--app=URL)
  tui add <name> <command> | remove <name> | list | sync   terminal programs as apps (e.g. dorm = ssh 192.168.1.50)
            Both lists live in ~/.local/state/torii/{webapps,tuis}.json (private data, not in the dotfiles repo; the
            home-server sync carries them). `sync` rewrites the .desktop files from those lists.
Nothing is moved or installed: the folders stay exactly where they are.
"""
import json
import os
import re
import shlex
import sys
from pathlib import Path

ICON_EXT = (".png", ".svg", ".xpm")


def apps_dir():
    try:
        cfg = json.loads((Path.home() / ".config/torii/config.json").read_text())
        d = cfg.get("apps", {}).get("dir", "~/apps")
    except (OSError, ValueError):
        d = "~/apps"
    return Path(os.path.expanduser(d))


def folders():
    root = apps_dir()
    return sorted(p for p in root.iterdir() if p.is_dir() and not p.name.startswith(".")) if root.is_dir() else []


# ---------------------------------------------------------------- generate
def is_program(p):
    try:
        if not p.is_file() or not os.access(p, os.X_OK) or p.suffix.lower() in (".so", ".png", ".icns", ".svg", ".json", ".txt", ".dll"):
            return False
        with open(p, "rb") as f:
            head = f.read(4)
        return head.startswith(b"\x7fELF") or head.startswith(b"#!")
    except OSError:
        return False


def find_program(folder):
    token = re.split(r"[-_ .]", folder.name.lower())[0]
    found = []
    for depth_glob in ("*", "*/*"):
        for p in folder.glob(depth_glob):
            if is_program(p) and p.name.lower().startswith(token):
                found.append(p)
    # the biggest one is the real program (not a helper that happens to share the prefix)
    return max(found, key=lambda p: p.stat().st_size) if found else None


def find_icon(folder, program):
    stem = program.stem.lower()
    best = None
    for p in list(folder.glob("*")) + list(folder.glob("*/*")):
        if p.suffix.lower() in ICON_EXT and p.stem.lower().startswith(stem[:4]):
            if best is None or p.suffix.lower() == ".png" and best.suffix.lower() != ".png":
                best = p
    return str(best) if best else "application-x-executable"


def quote(path):
    s = str(path)
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"' if re.search(r'[\s"\'\\$`]', s) else s


def generate():
    made = []
    for d in folders():
        if (d / "app.json").is_file() or list(d.glob("*.desktop")):
            continue
        prog = find_program(d)
        if not prog:
            continue
        out = d / (prog.stem + ".desktop")
        out.write_text(
            "[Desktop Entry]\nType=Application\nVersion=1.0\n"
            f"Name={prog.stem}\nComment=App from {d.parent.name}/{d.name}\nIcon={find_icon(d, prog)}\n"
            f"Path={prog.parent}\nExec={quote(prog)}\nTerminal=false\nCategories=Utility;\n")
        made.append(str(out))
    return made


# ---------------------------------------------------------------- scan
def read_desktop(f):
    keys, in_entry = {}, False
    try:
        for line in f.read_text(errors="replace").splitlines():
            if line.startswith("["):
                in_entry = line.strip() == "[Desktop Entry]"
            elif in_entry and "=" in line and not line.startswith("#"):
                k, _, v = line.partition("=")
                keys.setdefault(k.strip(), v.strip())
    except OSError:
        return None
    if keys.get("NoDisplay", "").lower() == "true" or keys.get("Hidden", "").lower() == "true":
        return None
    cmd = keys.get("Exec", "")
    cmd = re.sub(r"\s%[a-zA-Z]", "", cmd).replace("%%", "%").strip()
    return {"name": keys.get("Name") or f.stem, "exec": cmd, "icon": keys.get("Icon", ""), "dir": keys.get("Path", ""),
            "keywords": [k for k in keys.get("Keywords", "").split(";") if k], "description": keys.get("Comment", "")}


def scan():
    out = []
    for d in folders():
        entries = []
        for f in sorted(d.glob("*.desktop")):
            e = read_desktop(f)
            if e and e["exec"]:
                entries.append(e)
        manifest = d / "app.json"
        if not entries and manifest.is_file():
            try:
                m = json.loads(manifest.read_text())
            except (OSError, ValueError):
                m = None
            if isinstance(m, dict):
                if m.get("bottle") and m.get("program"):
                    ex = "bottles-cli run -b '%s' -p '%s'" % (m["bottle"], m["program"])
                elif m.get("exec"):
                    ex = m["exec"]
                    ex = " ".join(ex) if isinstance(ex, list) else str(ex)
                else:
                    ex = ""
                if ex:
                    icon = str(m.get("icon", ""))
                    if icon and (d / icon).is_file():
                        icon = str(d / icon)
                    entries.append({"name": str(m.get("name") or d.name), "exec": ex, "icon": icon, "dir": "",
                                    "keywords": [str(k) for k in m.get("keywords", []) if isinstance(k, (str, int))],
                                    "description": str(m.get("description", ""))})
        for e in entries:
            icon = e["icon"]
            if icon and not icon.startswith("/") and (d / icon).is_file():
                icon = str(d / icon)
            out.append({**e, "icon": icon, "dir": e["dir"] or str(d), "folder": d.name})
    return out


def desktop_sync():
    """~/.local/share/applications/torii-app-<name>.desktop for every app; entries of apps that are gone are removed."""
    target = Path.home() / ".local/share/applications"
    target.mkdir(parents=True, exist_ok=True)
    keep = set()
    for a in scan():
        slug = re.sub(r"[^a-z0-9]+", "-", a["name"].lower()).strip("-") or "app"
        f = target / f"torii-app-{slug}.desktop"
        keep.add(f.name)
        f.write_text(
            "[Desktop Entry]\nType=Application\nVersion=1.0\n"
            f"Name={a['name']}\nComment={a['description'] or 'App from ~/apps'}\nIcon={a['icon'] or 'application-x-executable'}\n"
            f"Path={a['dir']}\nExec={Path.home()}/.config/torii/bin/torii-apps run {shlex.quote(a['folder'])} {shlex.quote(a['name'])}\nTerminal=false\n"
            f"Keywords={';'.join(a['keywords'])};\nX-Torii-App=true\n")
    for old in target.glob("torii-app-*.desktop"):
        if old.name not in keep:
            old.unlink()
    return len(keep)


# ---------------------------------------------------------------- web apps and terminal apps
STATE = Path(os.environ.get("TORII_STATE", Path.home() / ".local/state/torii"))


def slug(name):
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-") or "app"


def load_list(name):
    try:
        data = json.loads((STATE / name).read_text())
        return data if isinstance(data, list) else []
    except (OSError, ValueError):
        return []


def save_list(name, items):
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = (STATE / name).with_suffix(".tmp")
    tmp.write_text(json.dumps(items, indent=2) + "\n")
    os.replace(tmp, STATE / name)


def favicon(url, name):
    """Site icon next to the other user icons; the theme's web icon when it cannot be fetched."""
    import subprocess
    from urllib.parse import urlparse
    host = urlparse(url if "://" in url else "https://" + url).netloc
    dest = Path.home() / ".local/share/icons/torii-web" / f"{slug(name)}.png"
    if dest.is_file():
        return str(dest)
    dest.parent.mkdir(parents=True, exist_ok=True)
    r = subprocess.run(["curl", "-fsSL", "-m", "8", "-o", str(dest), f"https://www.google.com/s2/favicons?domain={host}&sz=128"],
                       capture_output=True)
    if r.returncode != 0 or not dest.is_file() or dest.stat().st_size < 100:
        dest.unlink(missing_ok=True)
        return "web-browser"
    return str(dest)


def sync_web():
    target = Path.home() / ".local/share/applications"
    target.mkdir(parents=True, exist_ok=True)
    keep = set()
    for w in load_list("webapps.json"):
        url = w["url"] if "://" in w["url"] else "https://" + w["url"]
        from urllib.parse import urlparse
        u = urlparse(url)
        f = target / f"torii-web-{slug(w['name'])}.desktop"
        keep.add(f.name)
        f.write_text("[Desktop Entry]\nType=Application\nVersion=1.0\n"
                     f"Name={w['name']}\nComment=Web app\nIcon={favicon(url, w['name'])}\n"
                     f"Exec=helium-browser --app={url}\nTerminal=false\nCategories=Network;\nStartupWMClass=chrome-{u.netloc}_{(u.path or '/').replace('/', '_')}-Default\n"
                     "X-Torii-Web=true\n")
    for old in target.glob("torii-web-*.desktop"):
        if old.name not in keep:
            old.unlink()


def sync_tui():
    root = apps_dir()
    keep = set()
    for t in load_list("tuis.json"):
        d = root / slug(t["name"])
        d.mkdir(parents=True, exist_ok=True)
        f = d / f"{slug(t['name'])}.desktop"
        keep.add(f)
        run = d / "run.sh"
        run.write_text("#!/bin/sh\n" + t["command"] + "\nprintf '\\n[done, Enter to close] '\nread _\n")
        run.chmod(0o755)
        f.write_text("[Desktop Entry]\nType=Application\nVersion=1.0\n"
                     f"Name={t['name']}\nComment=Terminal app: {t['command']}\nIcon=utilities-terminal\n"
                     f"Exec=kitty --title {shlex.quote(t['name'])} {run}\nTerminal=false\nX-Torii-Tui=true\n")
    for old in root.glob("*/*.desktop") if root.is_dir() else []:
        if "X-Torii-Tui=true" in old.read_text(errors="replace") and old not in keep:
            old.unlink()
            (old.parent / "run.sh").unlink(missing_ok=True)
            try:
                old.parent.rmdir()
            except OSError:
                pass


def lists(kind, a):
    name = {"webapp": "webapps.json", "tui": "tuis.json"}[kind]
    key = "url" if kind == "webapp" else "command"
    items = load_list(name)
    if a[:1] == ["list"]:
        print(json.dumps(items))
        return
    if a[:1] == ["add"] and len(a) >= 3:
        items = [i for i in items if i["name"].lower() != a[1].lower()] + [{"name": a[1], key: " ".join(a[2:])}]
        save_list(name, items)
    elif a[:1] == ["remove"] and len(a) == 2:
        save_list(name, [i for i in items if i["name"].lower() != a[1].lower()])
    elif a[:1] != ["sync"]:
        sys.exit(__doc__)
    (sync_web if kind == "webapp" else sync_tui)()


if __name__ == "__main__":
    a = sys.argv[1:]
    if a[:1] in (["webapp"], ["tui"]):
        lists(a[0], a[1:])
        sys.exit(0)
    if a == ["list"]:
        generate()
        print(json.dumps(scan()))
    elif a == ["generate"]:
        print("\n".join(generate()))
    elif a == ["desktop"]:
        generate()
        print(desktop_sync())
    elif a[:1] == ["run"] and len(a) in (2, 3):
        for app in scan():
            if app["folder"] == a[1] and (len(a) == 2 or app["name"] == a[2]):
                os.chdir(app["dir"])
                os.execvp("sh", ["sh", "-c", 'PATH="$PWD:$PATH"; exec ' + app["exec"]])
        sys.exit("no app named " + " ".join(a[1:]))
    else:
        print(__doc__)
        sys.exit(2)

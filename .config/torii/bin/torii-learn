#!/usr/bin/env python3
"""torii-learn list <hypr|tmux|nvim> | files  -  your current keyboard shortcuts, read from the config files themselves.

  list hypr   ~/.config/hypr/modules/binds.lua   (mainMod is replaced by its real value)
  list tmux   ~/.config/tmux/tmux.conf           (prefix is taken from `set -g prefix`)
  list nvim   ~/.config/nvim/**/*.lua            (vim.keymap.set and lazy.nvim `keys` entries; <leader> shown as its key)
  files       your own notes: ~/.config/torii/learn/*.md
Prints JSON [{"keys": "ALT + SHIFT + R", "desc": "...", "file": "...", "line": 41}] (Enter in the launcher opens file at line).
The tip of a Hyprland bind is the comment line right above it (or a trailing comment); for binds made in a loop a line
`-- keys: ALT + 1 … 0 | tip` above the loop describes them. tmux: bind -N "tip"; nvim: desc = "tip". Nothing is cached: edit a config and it is current next time.
"""
import json
import re
import sys
from pathlib import Path

HOME = Path.home()


def pretty_key(part):
    names = {"left": "←", "right": "→", "up": "↑", "down": "↓", "mouse_down": "scroll down", "mouse_up": "scroll up",
             "mouse:272": "left mouse button", "mouse:273": "right mouse button", "comma": ",", "period": ".", "slash": "/"}
    return names.get(part, part)


def split_args(text):
    """The first top-level argument of `hl.bind(` is the key expression; the rest is the action."""
    depth, quote, cut = 0, "", len(text)
    for n, ch in enumerate(text):
        if quote:
            quote = "" if ch == quote else quote
        elif ch in "\"'":
            quote = ch
        elif ch in "({":
            depth += 1
        elif ch in ")}":
            depth -= 1
        elif ch == "," and depth == 0:
            cut = n
            break
    return text[:cut].strip(), text[cut + 1:].strip()


def hypr():
    f = HOME / ".config/hypr/modules/binds.lua"
    text = f.read_text(errors="replace") if f.exists() else ""
    m = re.search(r'local\s+mainMod\s*=\s*"([^"]+)"', text)
    main = m.group(1) if m else "SUPER"
    out, comment = [], ""
    lines = text.splitlines()
    for i, line in enumerate(lines):
        st = line.strip()
        ann = re.match(r"--\s*keys:\s*(.+?)\s*\|\s*(.+)$", st)      # -- keys: ALT + 1 … 0 | tip   (binds made in a loop)
        if ann:
            out.append({"keys": ann.group(1).replace("ALT", main) if main != "ALT" else ann.group(1), "desc": ann.group(2),
                        "file": str(f), "line": i + 1})
            continue
        if st.startswith("--") and not st.startswith("--hl") and not st.startswith("-- ("):
            comment = st.lstrip("- ").strip()
            continue
        if not st.startswith("hl.bind("):
            comment = ""
            continue
        j, body = i, ""
        while j < len(lines) and j < i + 12:                          # the bind may span several lines
            body += lines[j].strip() + " "
            if body.count("(") <= body.count(")"):
                break
            j += 1
        key_expr, action = split_args(body[len("hl.bind("):])
        parts = [x.strip() for x in re.split(r"\s*\.\.\s*", key_expr)]
        if any(not (x == "mainMod" or x[:1] in "\"'") for x in parts):
            comment = ""
            continue                                                   # a variable key: the "-- keys:" line above it tells
        keys = [main if x == "mainMod" else x.strip("\"'") for x in parts]
        k = re.sub(r"\s+", " ", re.sub(r"\s*\+\s*", " + ", " ".join(keys).strip()).strip(" +"))
        k = " + ".join(pretty_key(x.strip()) for x in k.split(" + "))
        tail = re.search(r"--\s*(.+)$", line.split(")", 1)[-1]) if "--" in line else None
        tip = (tail.group(1).strip() if tail else "") or (comment if not comment.startswith("Example") else "")
        out.append({"keys": k, "desc": tip or describe(action), "file": str(f), "line": i + 1})
        comment = ""
    seen, uniq = set(), []
    for e in out:
        if e["keys"] not in seen:
            seen.add(e["keys"])
            uniq.append(e)
    return uniq


def describe(action):
    a = re.sub(r"\)+\s*(,\s*\{.*)?$", "", action)
    a = a.replace("hl.dsp.", "")
    m = re.match(r'exec_cmd\((.*)', a)
    if m:
        cmd = m.group(1).replace("qsipc ..", "qs ipc call").replace('"', "").replace("$HOME", "~").strip()
        return "run " + (cmd if cmd not in ("terminal", "browser", "fileManager") else {"terminal": "the terminal", "browser": "the browser", "fileManager": "the file manager"}[cmd])
    m = re.match(r"(\w+(?:\.\w+)*)\((.*)", a)
    if m:
        name, arg = m.group(1).replace(".", " ").replace("_", " "), m.group(2)
        arg = re.sub(r"[{}=\"]", " ", arg)
        arg = re.sub(r"\b(direction|workspace|action|mode)\b", "", arg)
        return (name + " " + re.sub(r"\s+", " ", arg)).strip()
    return a


def tmux():
    import shlex
    f = HOME / ".config/tmux/tmux.conf"
    out, prefix, comment = [], "C-b", ""
    for ln, line in enumerate(f.read_text(errors="replace").splitlines() if f.exists() else []):
        st = line.strip()
        m = re.match(r"set(?:-option)?\s+-g\s+prefix\s+(\S+)", st)
        if m:
            prefix = m.group(1)
        if st.startswith("#"):
            comment = st.lstrip("# ").strip()
            continue
        if re.match(r"(bind-key|bind)\s", st):
            try:
                tok = shlex.split(st, comments=False)[1:]
            except ValueError:
                continue
            note, table, root, i = "", "", False, 0
            while i < len(tok) and tok[i].startswith("-"):
                if tok[i] == "-N":
                    note = tok[i + 1]; i += 2
                elif tok[i] == "-T":
                    table = tok[i + 1]; i += 2
                else:
                    root = root or "n" in tok[i][1:]; i += 1
            if i >= len(tok):
                continue
            key, cmd = tok[i], " ".join(tok[i + 1:])
            if table:
                keys = f"{key}   [{table.replace('copy-mode-vi', 'copy mode')}]"
            elif root:
                keys = key
            else:
                keys = f"{prefix} then {key}"
            out.append({"keys": keys, "desc": note or comment or cmd, "file": str(f), "line": ln + 1})
        if st:
            comment = ""
    return out


def nvim():
    root = HOME / ".config/nvim"
    out = []
    leader = " "
    files = sorted(root.rglob("*.lua")) if root.is_dir() else []
    for f in files:
        text = f.read_text(errors="replace")
        m = re.search(r'vim\.g\.mapleader\s*=\s*"(.*?)"', text)
        if m:
            leader = m.group(1)
    names = {" ": "Space", "\\": "\\", ",": ","}
    lead = names.get(leader, leader)
    for f in files:
        for ln, line in enumerate(f.read_text(errors="replace").splitlines()):
            st = line.strip()
            if st.startswith("--"):
                continue
            m = re.search(r'(?:vim\.keymap|\bo)\.set\(\s*(?:\{([^}]*)\}|"([^"]*)")\s*,\s*"([^"]*)"\s*,\s*(.*)', st)
            if m:
                modes = re.sub(r'["\s]', "", m.group(1) or m.group(2))
                rhs = m.group(4)
                d = re.search(r'desc\s*=\s*"([^"]*)"', rhs)
                desc = d.group(1) if d else re.sub(r",?\s*\{.*$|\)\s*$", "", rhs).strip().strip('"')
                out.append({"keys": m.group(3).replace("<leader>", lead + " ").replace("<Leader>", lead + " ") + (f"   [{modes}]" if modes not in ("n", "") else ""), "desc": desc,
                            "file": str(f), "line": ln + 1})
                continue
            m = re.match(r'map\("([^"]+)"\s*,.*,\s*"([^"]*)"\)\s*$', st)       # the LSP helper map(keys, fn, desc)
            if m:
                out.append({"keys": m.group(1).replace("<leader>", lead + " "), "desc": m.group(2) + " (LSP)", "file": str(f), "line": ln + 1})
                continue
            m = re.match(r'\{\s*"([^"]+)"\s*,.*desc\s*=\s*"([^"]*)"', st)
            if m:
                out.append({"keys": m.group(1).replace("<leader>", lead + " "), "desc": m.group(2), "file": str(f), "line": ln + 1})
    return out


def files():
    d = HOME / ".config/torii/learn"
    return [{"name": p.stem.replace("-", " ").replace("_", " "), "path": str(p)} for p in sorted(d.glob("*.md"))] if d.is_dir() else []


if __name__ == "__main__":
    a = sys.argv[1:]
    if a == ["files"]:
        print(json.dumps(files()))
    elif len(a) == 2 and a[0] == "list" and a[1] in ("hypr", "tmux", "nvim"):
        print(json.dumps({"hypr": hypr, "tmux": tmux, "nvim": nvim}[a[1]](), ensure_ascii=False))
    else:
        print(__doc__)
        sys.exit(2)

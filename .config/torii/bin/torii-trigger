#!/usr/bin/env python3
"""torii-trigger status  -  the current state of every switch in the launcher's Trigger menu, as JSON (one process, one call)."""
import json
import os
import subprocess
import sys
from pathlib import Path

BIN = Path(os.path.abspath(sys.argv[0])).parent


def out(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=4).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def js(text, default):
    try:
        return json.loads(text)
    except ValueError:
        return default


def status():
    return {
        "automove": js(out(str(BIN / "torii-automove"), "status"), {"enabled": False}),
        "dnd": out("swaync-client", "-D") == "true",
        "recording": subprocess.run(["pgrep", "-x", "wf-recorder"], capture_output=True).returncode == 0,
        "hypr": js(out(str(BIN / "torii-hypr"), "status"), {}),
        "shape": js(out(str(BIN / "torii-config"), "get", "notch.shape"), None) or "attached",
    }


if __name__ == "__main__" and sys.argv[1:] == ["status"]:
    print(json.dumps(status()))
else:
    print(__doc__)
    sys.exit(2)

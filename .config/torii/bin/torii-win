#!/usr/bin/env python3
"""torii-win close | max | dblclick | min | restore [address]  -  what the title bar buttons do (on the active window).

  close     close the window
  max       maximise / restore (a floating window fills the screen area, a second press gives it back)
  dblclick  what a double-click on the title bar does: the action chosen in Setup > Windows (maximise, fullscreen, big, center, minimise, none)
  min       hide the window on the special:minimized workspace; Alt+Tab (or `restore`) brings it back
  restore   bring the most recently minimised window (or the one at <address>) back to the current workspace
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

STATE = Path(os.environ.get("TORII_STATE", Path.home() / ".local/state/torii"))


def hc(*a):
    return subprocess.run(["hyprctl", *a], capture_output=True, text=True).stdout


def dispatch(expr):
    hc("dispatch", expr)


def clients():
    try:
        return json.loads(hc("clients", "-j"))
    except ValueError:
        return []


def main(a):
    cmd = a[0] if a else ""
    if cmd == "close":
        dispatch("hl.dsp.window.close()")
    elif cmd == "max":
        act = json.loads(hc("activewindow", "-j") or "{}")
        if act.get("floating") and act.get("fullscreen", 0) == 0:
            # floating windows fill the work area themselves (below the title bar, inside the gaps); see floatmode.lua
            hc("eval", "torii_float_maximize()")
        else:
            dispatch('hl.dsp.window.fullscreen({ mode = "maximized", action = "toggle" })')
    elif cmd == "dblclick":
        action = "max"
        try:
            m = re.search(r'dblclick\s*=\s*"(\w+)"', (STATE / "bars.lua").read_text())
            action = m.group(1) if m else "max"
        except OSError:
            pass
        if action == "fullscreen":
            dispatch('hl.dsp.window.fullscreen({ mode = "fullscreen", action = "toggle" })')
        elif action == "big":
            hc("eval", "torii_window_big()")
        elif action == "center":
            hc("eval", "torii_window_center()")
        elif action == "min":
            main(["min"])
        elif action != "none":
            main(["max"])
    elif cmd == "min":
        dispatch('hl.dsp.window.move({ workspace = "special:minimized", follow = false })')
    elif cmd == "restore":
        wins = [c for c in clients() if c["workspace"]["name"].startswith("special:minimized")]
        if a[1:]:
            wins = [c for c in wins if c["address"].lstrip("0x") == a[1].lstrip("0x")]
        if not wins:
            return
        ws = json.loads(hc("activeworkspace", "-j"))["id"]
        target = wins[-1]["address"]
        dispatch('hl.dsp.window.move({ workspace = %d, window = "address:%s", follow = false })' % (ws, target))
        dispatch('hl.dsp.focus({ window = "address:%s" })' % target)
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])

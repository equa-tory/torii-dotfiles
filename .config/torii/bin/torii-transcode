#!/usr/bin/env python3
"""torii-transcode list | run <file> <format> <size>  -  convert images and videos next to the original.

  list                          JSON: recent media in ~/Downloads, ~/Pictures, ~/Videos, ~/Pictures/Screenshots
  run <file> <fmt> <size>       fmt: png jpg jpeg webp (images)  mp4 mov gif (videos and gifs)
                                size: orig | p75 | p50 | p25 (percent) | w<px> (width) | h<px> (height)
The original is never touched: the result is <name>.<fmt> beside it (a number is added if that exists).
"""
import json
import os
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
IMAGES = {".png", ".jpg", ".jpeg", ".webp", ".bmp", ".tiff", ".tif", ".avif", ".heic"}
VIDEOS = {".mp4", ".mov", ".mkv", ".webm", ".avi", ".gif", ".m4v"}
ROOTS = [HOME / "Downloads", HOME / "Pictures", HOME / "Pictures/Screenshots", HOME / "Videos"]


def kind_of(p):
    s = p.suffix.lower()
    return "image" if s in IMAGES else "video" if s in VIDEOS else ""


def listing():
    found = {}
    for r in ROOTS:
        if not r.is_dir():
            continue
        for f in r.iterdir():
            try:
                if f.is_file() and not f.name.startswith(".") and kind_of(f):
                    found[str(f)] = (f.stat().st_mtime, f)
            except OSError:
                pass
    rows = sorted(found.values(), key=lambda x: -x[0])[:40]
    return [{"path": str(f), "name": f.name, "kind": kind_of(f), "dir": str(f.parent).replace(str(HOME), "~"),
             "size": f.stat().st_size} for _, f in rows]


def notify(title, body=""):
    subprocess.run(["notify-send", "-a", "torii", title, body], check=False)


def target_for(src, fmt):
    ext = fmt
    t = src.with_suffix("." + ext)
    n = 1
    while t.exists():
        t = src.with_name(f"{src.stem}-{n}.{ext}")
        n += 1
    return t


def scale_expr(size, video):
    if size == "orig":
        return None
    kind, val = size[0], size[1:]
    if kind == "p":
        pct = int(val)
        return f"trunc(iw*{pct}/100/2)*2:trunc(ih*{pct}/100/2)*2" if video else f"{pct}%"
    if kind == "w":
        return f"{int(val)}:-2" if video else f"{int(val)}x"
    if kind == "h":
        return f"-2:{int(val)}" if video else f"x{int(val)}"
    raise SystemExit("bad size " + size)


def run(src, fmt, size):
    src = Path(src).expanduser()
    if not src.is_file() or not kind_of(src):
        sys.exit("not a media file: " + str(src))
    out = target_for(src, fmt)
    video = kind_of(src) == "video" or fmt in ("mp4", "mov", "gif")
    sc = scale_expr(size, kind_of(src) == "video")
    notify("Converting " + src.name, "to " + fmt.upper())
    if kind_of(src) == "image" and fmt in ("png", "jpg", "jpeg", "webp"):
        cmd = ["magick", str(src) + "[0]"]
        if sc:
            cmd += ["-resize", sc]
        if fmt in ("jpg", "jpeg", "webp"):
            cmd += ["-quality", "90"]
        if fmt in ("jpg", "jpeg"):
            cmd += ["-background", "white", "-alpha", "remove", "-alpha", "off"]
        cmd += [str(out)]
    elif kind_of(src) == "video" and fmt in ("mp4", "mov"):
        cmd = ["ffmpeg", "-y", "-loglevel", "error", "-i", str(src)]
        if sc:
            cmd += ["-vf", "scale=" + sc]
        cmd += ["-c:v", "libx264", "-crf", "22", "-preset", "medium", "-pix_fmt", "yuv420p", "-c:a", "aac", "-movflags", "+faststart", str(out)]
    elif kind_of(src) == "video" and fmt == "gif":
        scale = (sc and f"scale={sc}:flags=lanczos,") or ""
        flt = f"fps=15,{scale}split[a][b];[a]palettegen[p];[b][p]paletteuse"
        cmd = ["ffmpeg", "-y", "-loglevel", "error", "-i", str(src), "-filter_complex", flt, str(out)]
    else:
        sys.exit(f"cannot turn a {kind_of(src)} into {fmt}")
    t0 = time.time()
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0 or not out.exists():
        notify("Conversion failed", (r.stderr or "").strip()[-200:])
        sys.exit(1)
    notify("Converted", f"{out.name}  ({out.stat().st_size // 1024} KB, {time.time() - t0:.0f}s)")
    print(out)


if __name__ == "__main__":
    a = sys.argv[1:]
    if a == ["list"]:
        print(json.dumps(listing()))
    elif len(a) == 4 and a[0] == "run":
        run(a[1], a[2], a[3])
    else:
        print(__doc__)
        sys.exit(2)

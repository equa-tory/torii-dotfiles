#!/usr/bin/env python3
"""torii-favicon <host>...  |  torii-favicon links <quicklinks.json>  -  fetch site icons into ~/.cache/torii/favicons/<host>.png

The launcher shows these for quicklinks that have no icon of their own. `links` reads the quicklinks file and fetches the
host of every entry without an "icon" (already downloaded ones are skipped). Prints the number of icons fetched.
"""
import json
import os
import re
import sys
import urllib.request
from pathlib import Path
from urllib.parse import urlparse

CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "torii" / "favicons"
SOURCES = ("https://www.google.com/s2/favicons?domain={h}&sz=64", "https://icons.duckduckgo.com/ip3/{h}.ico")


def fetch(host):
    dest = CACHE / f"{host}.png"
    if dest.exists() and dest.stat().st_size > 0:
        return False
    CACHE.mkdir(parents=True, exist_ok=True)
    for src in SOURCES:
        try:
            req = urllib.request.Request(src.format(h=host), headers={"User-Agent": "torii"})
            data = urllib.request.urlopen(req, timeout=8).read()
        except Exception:
            continue
        if len(data) > 100:
            dest.write_bytes(data)
            return True
    return False


def hosts_of(path):
    try:
        raw = json.loads(Path(path).expanduser().read_text())
    except (OSError, ValueError):
        return []
    entries = raw if isinstance(raw, list) else [{"url": v} if isinstance(v, str) else v for v in raw.values()]
    out = []
    for e in entries:
        if isinstance(e, dict) and e.get("url") and not e.get("icon"):
            h = (urlparse(re.sub(r"\{[^}]*\}", "x", e["url"])).hostname or "").removeprefix("www.")
            if h and h not in out:
                out.append(h)
    return out


def main(a):
    if a[:1] == ["links"] and len(a) == 2:
        hosts = hosts_of(a[1])
    elif a and a[0] not in ("-h", "--help"):
        hosts = [h.removeprefix("www.") for h in a]
    else:
        print(__doc__)
        sys.exit(2)
    print(sum(fetch(h) for h in hosts))


if __name__ == "__main__":
    main(sys.argv[1:])

#!/usr/bin/env python3
"""Token-authenticated remote power API, with private persistent settings."""
import fcntl
import hmac
from http.server import BaseHTTPRequestHandler, HTTPServer
import json
import os
import pwd
from pathlib import Path
import secrets
import subprocess
import sys

STATE = Path(os.environ.get('TORII_STATE', Path.home() / '.local/state/torii'))
SETTINGS = STATE / 'remote-power.json'
PORT = 10809
UNIT = 'torii-remote-power.service'


def settings(action=None):
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / 'remote-power.lock').open('w') as lock:
        os.chmod(lock.name, 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            data = json.loads(SETTINGS.read_text())
        except FileNotFoundError:
            data = {'enabled': False, 'token': secrets.token_urlsafe(32)}
        if action == 'regenerate':
            data['token'] = secrets.token_urlsafe(32)
        elif action in ('enable', 'disable'):
            data['enabled'] = action == 'enable'
        temporary = SETTINGS.with_suffix('.tmp')
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, 'w') as stream:
            json.dump(data, stream)
        temporary.replace(SETTINGS)
        return data


def poweroff():
    subprocess.run(['systemctl', 'poweroff'], check=True, timeout=15, capture_output=True)


class Handler(BaseHTTPRequestHandler):
    server_version = 'ToriiRemotePower'

    def log_message(self, *args):
        pass  # Never log authorization headers or request URLs.

    def reply(self, code, message):
        body = json.dumps({'message': message}).encode()
        self.send_response(code)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(body)))
        self.send_header('Cache-Control', 'no-store')
        self.end_headers()
        self.wfile.write(body)
        self.close_connection = True

    def do_POST(self):
        data = settings()
        if not data['enabled']:
            return self.reply(503, 'Remote shutdown is disabled')
        authorization = self.headers.get('Authorization', '')
        if not hmac.compare_digest(authorization.encode(), ('Bearer ' + data['token']).encode()):
            return self.reply(401, 'Unauthorized')
        if self.path != '/shutdown':
            return self.reply(404, 'Not found')
        try:
            poweroff()
        except (OSError, subprocess.SubprocessError):
            return self.reply(503, 'Shutdown failed; check the user service journal')
        self.reply(202, 'Shutting down')

    def do_GET(self):
        self.reply(405, 'Use POST /shutdown with Authorization: Bearer <token>')

    def setup(self):
        super().setup()
        self.connection.settimeout(5)


def install():
    directory = Path.home() / '.config/systemd/user'
    directory.mkdir(parents=True, exist_ok=True)
    executable = str(Path(__file__).resolve()).replace('%', '%%')
    (directory / UNIT).write_text('[Unit]\nDescription=Torii remote shutdown API\nAfter=network.target\n\n[Service]\n'
        f'ExecStart="{executable}" serve\nRestart=on-failure\nRestartSec=3\nNoNewPrivileges=yes\nUMask=0077\n\n[Install]\nWantedBy=default.target\n')
    subprocess.run(['systemctl', '--user', 'daemon-reload'], check=True)


def main(args):
    action = args[0] if args else 'status'
    if action == 'install-policy':
        if os.geteuid() != 0:
            raise ValueError('Administrator authorization required')
        username = pwd.getpwnam(args[1]).pw_name
        rule = 'polkit.addRule(function(action, subject) {\n' + (
            '  if (subject.user === ' + json.dumps(username) + ' && ["org.freedesktop.login1.power-off", '
            '"org.freedesktop.login1.power-off-multiple-sessions", '
            '"org.freedesktop.login1.power-off-ignore-inhibit"].indexOf(action.id) >= 0) return polkit.Result.YES;\n});\n')
        policy = Path('/etc/polkit-1/rules.d/49-torii-remote-power.rules')
        policy.write_text(rule)
        policy.chmod(0o644)
        return
    if action == 'serve':
        if settings()['enabled']:
            HTTPServer(('0.0.0.0', PORT), Handler).serve_forever()
        return
    if action not in ('status', 'enable', 'disable', 'regenerate', 'copy'):
        raise ValueError('Unknown action')
    data = settings(action)
    if action == 'enable':
        install()
        subprocess.run(['systemctl', '--user', 'enable', '--now', UNIT], check=True)
    elif action == 'disable':
        subprocess.run(['systemctl', '--user', 'disable', '--now', UNIT], check=True)
    elif action == 'copy':
        subprocess.run(['wl-copy'], input=data['token'].encode(), check=True)
    active = subprocess.run(['systemctl', '--user', 'is-active', '--quiet', UNIT]).returncode == 0
    interfaces = json.loads(subprocess.run(['ip', '-json', '-4', 'address', 'show', 'scope', 'global'],
                                          capture_output=True, text=True, check=True).stdout)
    addresses = [entry['local'] for interface in interfaces for entry in interface.get('addr_info', [])]
    urls = [f'http://{address}:{PORT}/shutdown' for address in addresses if ':' not in address]
    print(json.dumps(dict(enabled=data['enabled'], active=active, port=PORT, path='/shutdown',
                         urls=urls, method='POST', authentication='Authorization: Bearer <token>')))


if __name__ == '__main__':
    try:
        main(sys.argv[1:])
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(json.dumps({'error': str(error)}))
        sys.exit(1)

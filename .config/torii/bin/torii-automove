#!/usr/bin/env python3
"""torii-automove on|off|status|apply  -  move visual media from ~/Downloads to a folder, while it is switched on.
A .zip is unzipped (in archive order) into <unzipTo>/<zip name>/ and the zip is deleted; images and videos are moved
into <to> as they are. Other file types are left alone. unzipTo may be another path than <to>; empty means <to>/_.

  on       leave existing files alone; process only incoming visual media and ZIPs
  off      stop
  status   JSON: {"enabled", "since", "from", "to", "unzipTo"}
  apply    start the watcher again after login when it was left on (autostart runs this)
Folders: "automove": {"from": "~/Downloads", "to": "/mnt/mass/Media_MASS/Photo/inbox", "unzipTo": "/mnt/mass/Media_MASS/Photo/inbox/_"}
in ~/.config/torii/config.json.
The watcher is a systemd user service (torii-automove) that waits on inotify, so it uses no CPU while nothing happens.
If the destination is not there (share not mounted) nothing is moved or created and the files stay in Downloads.
"""
import ctypes
import json
import os
import shutil
import select
import subprocess
import struct
import sys
import time
import zipfile
from pathlib import Path

HOME = Path.home()
STATE = Path(os.environ.get("TORII_STATE", HOME / ".local/state/torii")) / "automove.json"
SKIP_EXT = (".part", ".crdownload", ".tmp", ".download", ".opdownload", ".partial", ".!qb", ".aria2", "~")
# Explicit allowlist: never move arbitrary documents, audio, code or executables.
VISUAL_EXT = frozenset({
    ".png", ".jpg", ".jpeg", ".jpe", ".jfif", ".webp", ".gif", ".apng",
    ".avif", ".heic", ".heif", ".bmp", ".tif", ".tiff", ".ico", ".jxl",
    ".mp4", ".m4v", ".mov", ".webm", ".mkv", ".avi", ".mpg", ".mpeg",
    ".mpe", ".ogv", ".wmv", ".flv", ".3gp", ".3g2",
})
IN_CLOSE_WRITE, IN_MOVED_TO = 0x8, 0x80
IN_MOVED_FROM, IN_DELETE = 0x40, 0x200
IN_Q_OVERFLOW = 0x4000


def cfg():
    src, dst = "~/Downloads", "/mnt/mass/Media_MASS/Photo/inbox"
    try:
        c = json.loads((HOME / ".config/torii/config.json").read_text()).get("automove", {})
        src, dst = c.get("from", src), c.get("to", dst)
    except (OSError, ValueError):
        pass
    return Path(os.path.expanduser(src)), Path(os.path.expanduser(dst))


def unzip_to(dst):
    name = ""
    try:
        name = json.loads((HOME / ".config/torii/config.json").read_text()).get("automove", {}).get("unzipTo", "") or ""
    except (OSError, ValueError):
        pass
    return Path(os.path.expanduser(name)) if name else dst / "_"


def extract(zpath, target):
    """Unzip into target; entries that would land outside it are skipped."""
    target.mkdir(parents=True, exist_ok=True)
    root = os.path.abspath(target)
    with zipfile.ZipFile(zpath) as zf:
        for m in zf.namelist():
            out = os.path.abspath(os.path.join(root, m))
            if out != root and not out.startswith(root + os.sep):
                continue
            if m.endswith("/"):
                os.makedirs(out, exist_ok=True)
                continue
            os.makedirs(os.path.dirname(out), exist_ok=True)
            with zf.open(m) as a, open(out, "wb") as b:
                shutil.copyfileobj(a, b)


UNZIP_WARNED = [False]


def handle_zip(f, dst):
    base = unzip_to(dst)
    if not base.is_dir():
        if base.parent.is_dir():
            base.mkdir(exist_ok=True)
        else:                                                     # another share that is not mounted: keep the zip for later
            if not UNZIP_WARNED[0]:
                notify("Auto mover waiting", f"{base} is not there (is the share mounted?)")
                UNZIP_WARNED[0] = True
            return
    UNZIP_WARNED[0] = False
    target = base / f.stem
    if not (target.is_dir() and any(target.iterdir())):          # already unzipped once: just drop the archive
        try:
            extract(f, target)
        except (zipfile.BadZipFile, OSError) as e:
            notify("Auto mover: could not unzip " + f.name, str(e))
            return
    f.unlink()


def load():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {"enabled": False, "since": 0}


def save(s):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(s))
    os.replace(tmp, STATE)


def notify(title, body=""):
    subprocess.run(["notify-send", "-a", "torii", title, body], check=False)


def unit(action):
    subprocess.run(["systemctl", "--user", "stop", "torii-automove.service"], capture_output=True)
    if action == "start":
        subprocess.run(["systemd-run", "--user", "--collect", "--unit=torii-automove", os.path.abspath(sys.argv[0]), "watch"],
                       capture_output=True)



def identity(path):
    stat = path.lstat()
    return [stat.st_dev, stat.st_ino]


def snapshot(src):
    ignored = {}
    for path in src.iterdir():
        try:
            ignored[path.name] = identity(path)
        except FileNotFoundError:
            pass  # A download may finish or leave while taking the snapshot.
    return ignored


def arrivals(events, ignored):
    """Forget departed names even if the same inode comes back before a sweep."""
    offset = 0
    overflow = False
    while offset + 16 <= len(events):
        _, mask, _, length = struct.unpack_from('iIII', events, offset)
        name = os.fsdecode(events[offset + 16:offset + 16 + length].split(b'\0', 1)[0])
        if mask & (IN_MOVED_FROM | IN_DELETE):
            ignored.pop(name, None)
        overflow |= bool(mask & IN_Q_OVERFLOW)
        offset += 16 + length
    return overflow


def sweep(src, dst, warned, ignored):
    for name in list(ignored):
        try:
            if identity(src / name) != ignored[name]:
                ignored.pop(name)
        except FileNotFoundError:
            ignored.pop(name)
    if not dst.is_dir():
        if dst.parent.is_dir():
            dst.mkdir(exist_ok=True)
        else:
            if not warned[0]:
                notify("Auto mover waiting", f"{dst} is not there (is the share mounted?)")
                warned[0] = True
            return
    warned[0] = False
    for f in sorted(src.iterdir()):
        try:
            if f.name in ignored:
                continue
            if f.name.startswith(".") or f.name.lower().endswith(SKIP_EXT) or f.is_symlink() or not f.is_file():
                continue
            if f.suffix.lower() not in VISUAL_EXT and f.suffix.lower() != ".zip":
                continue
            size = f.stat().st_size
            time.sleep(0.8)                       # still being written?
            if f.stat().st_size != size:
                continue
            if f.suffix.lower() == ".zip":
                handle_zip(f, dst)
                continue
            target = dst / f.name
            n = 1
            while target.exists():
                target = dst / f"{f.stem}-{n}{f.suffix}"
                n += 1
            shutil.move(str(f), str(target))
        except OSError as e:
            notify("Auto mover: could not move " + f.name, str(e))


def watch():
    src, dst = cfg()
    libc = ctypes.CDLL("libc.so.6", use_errno=True)
    fd = libc.inotify_init1(os.O_CLOEXEC)
    if fd < 0 or libc.inotify_add_watch(fd, str(src).encode(), IN_CLOSE_WRITE | IN_MOVED_TO | IN_MOVED_FROM | IN_DELETE) < 0:
        sys.exit("cannot watch " + str(src))
    ignored = load().get("ignored")
    if ignored is None:  # Safe migration from an older session.
        ignored = snapshot(src)
    warned = [False]
    sweep(src, dst, warned, ignored)
    while True:
        # Retry pending files even if a write is unfinished or the NAS was offline.
        ready, _, _ = select.select([fd], [], [], 10)
        if ready:
            if arrivals(os.read(fd, 65536), ignored):
                # Lost events cannot safely distinguish old files from arrivals.
                ignored = snapshot(src)
            time.sleep(0.5)
        s = load()
        if not s.get("enabled"):
            return
        sweep(src, dst, warned, ignored)


def main(a):
    cmd = a[0] if a else "status"
    src, dst = cfg()
    if cmd == "status":
        s = load()
        print(json.dumps({"enabled": bool(s.get("enabled")), "since": s.get("since", 0), "from": str(src), "to": str(dst), "unzipTo": str(unzip_to(dst))}))
    elif cmd == "on":
        unit("stop")
        save({"enabled": True, "since": time.time(), "from": str(src), "to": str(dst), "ignored": snapshot(src)})
        unit("start")
    elif cmd == "off":
        save({"enabled": False, "since": 0, "from": str(src), "to": str(dst)})
        unit("stop")
    elif cmd == "apply":
        s = load()
        if s.get("enabled"):
            unit("stop")
            s["ignored"] = snapshot(src)
            save(s)
            unit("start")
    elif cmd == "watch":
        watch()
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])

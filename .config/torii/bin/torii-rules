#!/usr/bin/env python3
"""torii-rules list | windows | focused | specials | autostart | set <rule> <key> <value> | remove <rule> | apply  -  per-app window rules.

A rule says what happens when a window of an app opens:
  workspace  1..10, special:NAME or none   send it there (in the background when `silent` is true)
  silent     true|false           open on that workspace without switching to it
  float      true|false           open floating
  remember   true|false           open floating where (and how big) it was last time (implies floating)
  autostart  true|false           start the app when the session starts (needs a desktop entry or a command with that name)
  snapshot-workspace [N|special:NAME]          do that for every app on workspace N (the current one by default); it replaces what was saved for N
  reopen [N]                      start the saved apps (of workspace N) that are not open, leave the open ones alone
  snapshot <class>                take over how the app's window is right now: its workspace, floating or not, place and size
                                  (remembered), opened in the background, and started at login
  name       text                 label shown in the launcher
A <rule> is the window class, or class|title for one kind of window of an app (a login popup of a browser: matched on the
title it opened with). `focused` prints the window that has the focus, `windows` lists the windows that are open now (their class is what a rule matches), `list` the saved rules.
Rules live in ~/.config/torii/app-rules.json; the Hyprland side is ~/.local/state/torii/hypr-rules.lua (hyprland.lua loads it)
and is also applied to the running session at once.
"""
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
RULES = Path(os.environ.get("TORII_RULES", HOME / ".config/torii/app-rules.json"))
STATE = Path(os.environ.get("TORII_STATE", HOME / ".local/state/torii"))
LUA, SEEN = STATE / "hypr-rules.lua", STATE / "app-rules-applied.json"


def load(path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


def lstr(s):
    return json.dumps(s, ensure_ascii=False)          # a JSON string is a valid Lua string


def key(r):
    """A rule belongs to an app (its class) or, when `title` is set, to one kind of window of it (a browser's login popup)."""
    return r["class"] + ("|" + r["title"] if r.get("title") else "")


def find(rules, k):
    return next((x for x in rules if key(x) == k), None)


def rule_name(k):
    name = "torii-rule-" + re.sub(r"[^A-Za-z0-9_.-]", "_", k.split("|", 1)[0])
    if "|" in k:
        name += "-" + hashlib.sha1(k.encode()).hexdigest()[:8]
    return name


def ws_text(ws):
    return ws if isinstance(ws, str) else str(ws)


def rx(text):
    return "^" + re.escape(text).replace("\\-", "-").replace("\\ ", " ") + "$"


def lua(rules):
    """One window_rule per app. A rule that was applied before and is gone now is switched off by giving it a class
    that never matches (a running Hyprland keeps a rule until it is replaced)."""
    seen = set(load(SEEN, []))
    out = ["-- generated by torii-rules, do not edit"]
    live = set()
    remember = [r["class"] for r in rules if r.get("remember") and not r.get("title")]
    out.append("torii_remember_apps = {%s}" % ", ".join("[%s]=true" % lstr(c) for c in remember))     # read by hypr/modules/floatmode.lua
    for r in rules:
        ws, fl = r.get("workspace"), bool(r.get("float") or r.get("remember"))
        if not ws and not fl:
            continue
        live.add(key(r))
        m = f"class={lstr(rx(r['class']))}"
        if r.get("title"):                               # a popup: the title it had when it opened
            m += f", initial_title={lstr(rx(r['title']))}"
        fields = [f"name={lstr(rule_name(key(r)))}", f"match={{{m}}}"]
        if ws:
            fields.append(f"workspace={lstr(ws_text(ws) + (' silent' if r.get('silent') else ''))}")
        if fl:
            fields.append("float=true")
        out.append("hl.window_rule({%s})" % ", ".join(fields))
    for k in sorted(seen - live):
        out.append("hl.window_rule({name=%s, match={class=\"^torii-no-such-class$\"}, float=false})" % lstr(rule_name(k)))
    return "\n".join(out) + "\n", live | seen


def apply():
    rules = load(RULES, [])
    text, seen = lua(rules)
    write(LUA, text)
    write(SEEN, json.dumps(sorted(seen)))
    if not os.environ.get("TORII_NO_HOOKS") and os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        body = "\n".join(l for l in text.splitlines() if not l.startswith("--"))
        subprocess.run(["hyprctl", "eval", body], capture_output=True)


def start_command(cls):
    """How to start the app of a window class: its desktop entry (StartupWMClass or the same name), else a program with that name."""
    dirs = [HOME / ".local/share/applications"] + [Path(d) / "applications" for d in
            os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")]
    low = cls.lower()
    for d in dirs:
        if not d.is_dir():
            continue
        for f in sorted(d.glob("*.desktop")):
            if f.stem.lower() == low or f.stem.lower().endswith("." + low):
                return "desktop:" + f.name
            try:
                for line in f.read_text(errors="replace").splitlines():
                    if line.lower().startswith("startupwmclass=") and line.split("=", 1)[1].strip().lower() == low:
                        return "desktop:" + f.name
            except OSError:
                pass
    return "cmd:" + shutil.which(low) if shutil.which(low) else ""


def hypr_clients():
    try:
        return json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=3).stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        return []


def app_label(cls):
    if cls.startswith("torii-app-"):                 # a terminal app from ~/apps: use its launcher name
        try:
            apps = json.loads(subprocess.run([str(HOME / ".config/torii/bin/torii-apps"), "list"], capture_output=True, text=True, timeout=5).stdout)
            return next((a["name"] for a in apps if "--class " + cls + " " in a["exec"] + " "), cls)
        except (OSError, ValueError, subprocess.SubprocessError):
            pass
    return cls


def take(rules, c):
    """Put what the window c looks like into the rule of its class (workspace, floating, place kept, background, start at login)."""
    cls = c["class"]
    r = find(rules, cls)
    if r is None:
        r = {"class": cls, "name": app_label(cls)}
        rules.append(r)
    ws = c["workspace"]["id"]
    if ws > 0:
        r["workspace"] = ws
    elif c["workspace"]["name"].startswith("special:") and c["workspace"]["name"] != "special:minimized":
        r["workspace"] = c["workspace"]["name"]
    r["float"] = bool(c.get("floating"))
    r["remember"] = bool(c.get("floating"))          # a tiled window has no place of its own to keep
    r["silent"] = True                               # opens on its workspace without pulling you there
    cmd = start_command(cls)
    if cmd:
        r["autostart"], r["exec"] = True, cmd
    return r, bool(cmd)


def finish(rules, classes):
    write(RULES, json.dumps(rules, indent=2, ensure_ascii=False) + "\n")
    apply()
    if not os.environ.get("TORII_NO_HOOKS"):
        for cls in classes:
            subprocess.run(["hyprctl", "eval", 'torii_remember_class_now(%s)' % lstr(cls)], capture_output=True)


def snapshot(cls):
    """The app's open window decides: workspace, floating, place and size, background, start at login."""
    clients = hypr_clients()
    c = next((x for x in clients if x.get("class") == cls and not x["workspace"]["name"].startswith("special")), None) \
        or next((x for x in clients if x.get("class") == cls), None)
    if not c:
        subprocess.run(["notify-send", "-a", "torii", "No window of " + cls, "Open the app and put it where you want it first"], capture_output=True)
        sys.exit("no open window of " + cls)
    rules = load(RULES, [])
    r, startable = take(rules, c)
    finish(rules, [cls] if c.get("floating") else [])
    summary = ["workspace %s" % r.get("workspace", "-"), "floating" if r["float"] else "tiled", "background", "starts at login" if startable else "no way found to start it"]
    subprocess.run(["notify-send", "-a", "torii", "Saved how %s is now" % r.get("name", cls), ", ".join(summary)], capture_output=True)


def snapshot_workspace(ws=None):
    """Every app on a workspace (the current one by default): how the workspace looks now is how login will build it."""
    if ws is None:
        try:
            ws = json.loads(subprocess.run(["hyprctl", "activeworkspace", "-j"], capture_output=True, text=True, timeout=3).stdout)["id"]
        except (OSError, ValueError, KeyError, subprocess.SubprocessError):
            sys.exit("no active workspace")
    seen, wins = set(), []
    for c in hypr_clients():
        cls = c.get("class") or ""
        if (c["workspace"]["id"] == ws or c["workspace"]["name"] == ws) and cls and cls not in seen and (not cls.startswith("torii-") or cls.startswith("torii-app-")):
            seen.add(cls)
            wins.append(c)
    if not wins:
        subprocess.run(["notify-send", "-a", "torii", "Workspace %s is empty" % ws, "Open and arrange the apps first"], capture_output=True)
        sys.exit("empty workspace")
    rules = load(RULES, [])
    names, floating = [], []
    for c in wins:
        r, _ = take(rules, c)
        names.append(r.get("name", c["class"]))
        if c.get("floating"):
            floating.append(c["class"])
    # the capture replaces what was saved for this workspace: an app saved here that is not on it now is dropped
    here = {c["class"] for c in wins}
    dropped = [r.get("name", r["class"]) for r in rules if r.get("workspace") == ws and r["class"] not in here]
    rules = [r for r in rules if not (r.get("workspace") == ws and r["class"] not in here)]
    finish(rules, floating)
    msg = ", ".join(names) + ": they will open like this at login"
    if dropped:
        msg += " (no longer saved here: " + ", ".join(dropped) + ")"
    subprocess.run(["notify-send", "-a", "torii", "Saved workspace %s" % ws, msg], capture_output=True)


def autostart(only_missing=False, ws=None):
    """Start every app that has autostart on. At login all of them; with only_missing (the launcher's "open all saved apps")
    just those that have no window yet, so what is open stays as it is. ws limits it to one workspace."""
    running = {c.get("class") for c in hypr_clients()} if only_missing else set()
    for r in load(RULES, []):
        if not r.get("autostart") or not r.get("exec") or r.get("title"):
            continue
        if r.get("title") or (only_missing and r["class"] in running):
            continue
        if ws is not None and r.get("workspace") != ws:
            continue
        kind, _, what = r["exec"].partition(":")
        if kind == "desktop":
            argv = [str(HOME / ".config/torii/bin/torii-apps"), "open", what]
        else:
            argv = ["uwsm", "app", "--", what] if shutil.which("uwsm") else [what]
        subprocess.Popen(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def windows():
    try:
        out = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=3).stdout
        clients = json.loads(out)
    except (OSError, ValueError, subprocess.SubprocessError):
        return []
    seen, res = set(), []
    for c in clients:
        cls = c.get("class") or ""
        if not c.get("mapped") or not cls or (cls.startswith("torii-") and not cls.startswith("torii-app-")):
            continue
        first = cls not in seen
        k = (cls, c.get("initialTitle", ""))
        if k in seen:
            continue
        seen.update([cls, k])
        res.append({"class": cls, "title": c.get("title", ""), "initialTitle": c.get("initialTitle", ""),
                    "popup": not first, "workspace": c["workspace"]["name"], "floating": bool(c.get("floating"))})
    return res


def specials():
    """Special workspaces that exist now (minimized is torii's own), with how many windows they hold."""
    try:
        ws = json.loads(subprocess.run(["hyprctl", "workspaces", "-j"], capture_output=True, text=True, timeout=3).stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        return []
    return [{"name": w["name"], "windows": w["windows"]} for w in ws if w["name"].startswith("special:") and w["name"] != "special:minimized"]


def main(a):
    rules = load(RULES, [])
    if a == ["list"]:
        print(json.dumps([dict(r, key=key(r)) for r in rules]))
        return
    if a == ["specials"]:
        print(json.dumps(specials()))
        return
    if a == ["windows"]:
        print(json.dumps(windows()))
        return
    if a == ["focused"]:
        try:
            w = json.loads(subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True, timeout=3).stdout or "{}")
        except (OSError, ValueError, subprocess.SubprocessError):
            w = {}
        cls = w.get("class") or ""
        print(json.dumps({"class": cls, "title": w.get("title", "")} if cls and not (cls.startswith("torii-") and not cls.startswith("torii-app-")) else {}))
        return
    if a == ["apply"]:
        apply()
        return
    if a == ["autostart"]:
        autostart()
        return
    if a[:1] == ["reopen"] and len(a) <= 2:
        autostart(True, int(a[1]) if len(a) == 2 and a[1].isdigit() else None)
        return
    if len(a) == 2 and a[0] == "snapshot":
        snapshot(a[1])
        return
    if a[:1] == ["snapshot-workspace"] and len(a) <= 2:
        snapshot_workspace(int(a[1]) if len(a) == 2 and a[1].isdigit() else a[1] if len(a) == 2 and a[1].startswith("special:") else None)
        return
    if len(a) == 4 and a[0] == "set":
        rk, field, val = a[1], a[2], a[3]
        cls, _, title = rk.partition("|")
        r = find(rules, rk)
        if r is None:
            r = {"class": cls, "name": cls + (" · " + title if title else "")}
            if title:
                r["title"] = title
            rules.append(r)
        if field == "workspace":
            if val == "none":
                r.pop("workspace", None)
            elif val.isdigit() and 1 <= int(val) <= 99:
                r["workspace"] = int(val)
            elif re.fullmatch(r"special:[A-Za-z0-9_-]+", val) and val != "special:minimized":
                r["workspace"] = val
            else:
                sys.exit("workspace is 1..10, special:NAME or none")
        elif field in ("silent", "float", "remember"):
            r[field] = val == "true"
        elif field == "autostart":
            if val == "true":
                cmd = start_command(cls)
                if not cmd:
                    subprocess.run(["notify-send", "-a", "torii", "Can't start " + cls, "No desktop entry or program with that name"], capture_output=True)
                    sys.exit("no way to start " + cls)
                r["autostart"], r["exec"] = True, cmd
            else:
                r.pop("autostart", None)
                r.pop("exec", None)
        elif field == "name":
            r["name"] = val
        else:
            sys.exit("unknown key " + field)
    elif len(a) == 2 and a[0] == "remove":
        rules = [x for x in rules if key(x) != a[1]]
    else:
        print(__doc__)
        sys.exit(2)
    write(RULES, json.dumps(rules, indent=2, ensure_ascii=False) + "\n")
    apply()


if __name__ == "__main__":
    main(sys.argv[1:])

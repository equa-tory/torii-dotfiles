#!/usr/bin/env bash
# torii-sync apps | status | toggle-app FILE | push ITEM... | pull ITEM... | restore-helium COPY   -  what the launcher's Install > Sync menu runs.
#
# Items (you tick them in the menu):
#   configs    the dotfiles repo (GitHub): push = commit + push, pull = pull (your uncommitted changes are kept)
#   helium     the whole Helium profile: cookies, extensions, bookmarks, settings       (torii-private on the home server)
#   webapps    the web apps list and their logins (Telegram, Discord, ...)             (torii-private)
#   apps       your own .desktop apps ticked in the menu (list: ~/.local/state/torii/backup-apps.txt) and the ~/apps folders they use
#   localsend  LocalSend settings                                                       (torii-private)
# Push OVERWRITES the saved copy with what is on this computer; pull OVERWRITES files here with the saved copy
# (a replaced private file is kept next to it as *.bak). Helium and the web apps are closed for it and opened again after.
set -uo pipefail

cfg="$(readlink -f "$HOME/.config/torii" 2>/dev/null || true)"
REPO="${TORII_REPO:-$( [ -n "$cfg" ] && dirname "$(dirname "$cfg")" || echo "$HOME/torii-dotfiles" )}"
LIST="${TORII_STATE:-$HOME/.local/state/torii}/backup-apps.txt"
APPS="$HOME/.local/share/applications"
pause() { printf '\n%s ' "${1:-Press Enter to close}"; read -r _; }
say() { printf '\n==> %s\n' "$*"; }

# Helium and the web apps (Telegram, Discord...) are Helium windows with the profile open: close them for a consistent copy
# (a clean exit writes everything out), and open the same windows again afterwards.
REOPEN="$(mktemp)"
close_helium() {
  # which Helium windows are open: web apps (their desktop entry has the window class) and a plain browser window
  : > "$REOPEN"
  classes=$(hyprctl clients -j 2>/dev/null | jq -r '.[].class')
  for f in "$APPS"/torii-web-*.desktop; do
    [ -f "$f" ] || continue
    wm=$(sed -n 's/^StartupWMClass=//p' "$f" | head -1)
    [ -n "$wm" ] && printf '%s\n' "$classes" | grep -qxF "$wm" && echo "desktop:$(basename "$f")" >> "$REOPEN"
  done
  printf '%s\n' "$classes" | grep -qxF helium && echo "plain" >> "$REOPEN"
  pgrep -x helium >/dev/null || return 0
  say "Closing Helium and the web apps"
  pkill -TERM -x helium
  for _ in $(seq 1 120); do pgrep -x helium >/dev/null || break; sleep 0.5; done      # a clean exit can take a while
  if pgrep -x helium >/dev/null; then echo "  Helium did not close, stopping it"; pkill -KILL -x helium; sleep 1; fi
  sleep 2
  # a dying browser may leave its lock files: a new one must not trust them (two Helium processes on one profile break it)
  rm -f "$HOME"/.config/net.imput.helium/Singleton{Lock,Cookie,Socket}
}
reopen_helium() {
  [ -s "$REOPEN" ] || return 0
  say "Opening Helium and the web apps again"
  first=1
  while IFS= read -r what; do
    case "$what" in
      desktop:*) "$HOME/.config/torii/bin/torii-apps" open "${what#desktop:}" >/dev/null 2>&1 ;;
      plain) (setsid helium-browser >/dev/null 2>&1 &) ;;
    esac
    # the first window starts the browser: give it time to take the profile lock, so the others join it instead of starting a second one
    if [ "$first" = 1 ]; then for _ in $(seq 1 20); do [ -L "$HOME/.config/net.imput.helium/SingletonLock" ] && break; sleep 0.5; done; sleep 3; first=0; else sleep 1; fi
  done < "$REOPEN"
  [ "$(ps -eo args= | grep -E '^/opt/helium-browser-bin/helium( |$)' | grep -vc -- '--type=')" -le 1 ] || echo "  !! two Helium processes are running on one profile: close all Helium windows and open them again"
}
needs_helium() { case " $* " in *" helium "*|*" webapps "*) return 0 ;; *) return 1 ;; esac; }

# your own .desktop files (what torii or packages generate is not backed up: it is rebuilt)
own() { for f in "$APPS"/*.desktop; do [ -f "$f" ] || continue; case "$(basename "$f")" in torii-*|claude-code-url-handler.desktop) ;; *) basename "$f" ;; esac; done; }

case "${1:-}" in
  apps)
    python3 -c '
import json, sys
chosen = set()
try:
    chosen = {l.strip() for l in open(sys.argv[1]) if l.strip() and not l.startswith("#")}
except OSError:
    pass
print(json.dumps([{"file": n, "on": n in chosen} for n in sys.argv[2:]]))' "$LIST" $(own)
    ;;
  status)
    # per item {"up": files newer here, "down": files newer on the server / GitHub}; null = could not be checked
    t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
    for it in helium webapps apps localsend; do
      for d in up down; do ( ONLY=$it COUNT=$d bash "$REPO/packages/private-push.sh" > "$t/$it.$d" 2>/dev/null ) & done
    done
    git -C "$REPO" fetch --quiet 2>/dev/null
    ahead=0; behind=0
    if git -C "$REPO" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then read -r ahead behind < <(git -C "$REPO" rev-list --left-right --count "HEAD...@{u}"); fi
    dirty=$(git -C "$REPO" status --porcelain | wc -l)
    wait
    python3 - "$t" "$((dirty + ahead))" "$behind" <<'PY'
import json, sys, os
t = sys.argv[1]
def rd(it, d):
    try:
        v = open(os.path.join(t, it + "." + d)).read().strip()
        return int(v) if v.isdigit() else None
    except OSError:
        return None
out = {"configs": {"up": int(sys.argv[2]), "down": int(sys.argv[3])}, "heliumOpen": os.system("pgrep -x helium >/dev/null") == 0}
for it in ("helium", "webapps", "apps", "localsend"):
    out[it] = {"up": rd(it, "up"), "down": rd(it, "down")}
print(json.dumps(out))
PY
    ;;
  toggle-app)
    [ -n "${2:-}" ] || exit 2
    mkdir -p "$(dirname "$LIST")"; touch "$LIST"
    if grep -qxF "$2" "$LIST"; then grep -vxF "$2" "$LIST" > "$LIST.tmp"; mv "$LIST.tmp" "$LIST"; else echo "$2" >> "$LIST"; fi ;;
  push)
    shift; items="$*"; [ -n "$items" ] || { echo "Nothing ticked."; pause; exit 0; }
    say "Push: this computer -> saved copy (overwrites the copy)"
    echo "  $items"
    needs_helium $items && echo "  Helium and the web apps (Telegram, Discord) will be closed for the copy and opened again after it."
    case " $items " in *" configs "*)
      echo; echo "  Changed config files:"; git -C "$REPO" status --short | head -20 | sed 's/^/    /'
      echo "  (all of them are committed and pushed to GitHub, replacing what is there)" ;; esac
    printf '\nContinue? [y/N] '; read -r yn; case "$yn" in y|Y) ;; *) echo "Nothing was changed."; pause; exit 0 ;; esac
    needs_helium $items && { close_helium; export FORCE=1; }
    for it in $items; do
      case "$it" in
        configs)
          cd "$REPO" || continue
          say "Configs -> GitHub"
          [ -z "$(git status --porcelain)" ] || { git add -A && git commit -q -m "Update configs from $(uname -n)"; }
          git pull --rebase --autostash -q || { echo "Pull failed, configs were not pushed."; continue; }
          git push || echo "Push failed" ;;
        helium)    say "Helium profile -> torii-private"; FORCE=${FORCE:-0} ONLY=helium bash "$REPO/packages/private-push.sh" ;;
        webapps)   say "Web apps and logins -> torii-private"; ONLY=webapps bash "$REPO/packages/private-push.sh" ;;
        apps)      say "Your apps -> torii-private"; ONLY=apps bash "$REPO/packages/private-push.sh" ;;
        localsend) say "LocalSend -> torii-private"; ONLY=localsend bash "$REPO/packages/private-push.sh" ;;
        *) echo "unknown item $it" ;;
      esac
    done
    needs_helium $items && reopen_helium
    say "Done"; pause ;;
  pull)
    shift; items="$*"; [ "$items" = all ] && items="configs helium webapps apps localsend"
    [ -n "$items" ] || { echo "Nothing to pull."; pause; exit 0; }
    say "Pull: saved copy -> this computer (overwrites files here)"
    echo "  $items"
    needs_helium $items && echo "  Helium and the web apps will be closed while it replaces the profile files (old ones are kept as *.bak) and opened again after."
    case " $items " in *" configs "*) echo "  Configs: new commits from GitHub are applied; your uncommitted changes are kept on top." ;; esac
    printf '\nContinue? [y/N] '; read -r yn; case "$yn" in y|Y) ;; *) echo "Nothing was changed."; pause; exit 0 ;; esac
    private=""
    needs_helium $items && close_helium
    for it in $items; do
      case "$it" in
        configs)
          cd "$REPO" || continue
          say "Configs <- GitHub"
          git pull --rebase --autostash || echo "Pull failed"
          command -v stow >/dev/null && [ "$(readlink -f "$HOME/.config/torii")" = "$(readlink -f "$REPO/.config/torii")" ] && stow . 2>&1 | tail -3 ;;
        helium|webapps|apps|localsend) private="$private $it" ;;
        *) echo "unknown item $it" ;;
      esac
    done
    if [ -n "$private" ]; then say "torii-private <-$private"; PULL_ONLY="${private# }" bash "$REPO/packages/personal.sh"; fi
    needs_helium $items && reopen_helium
    case " $private " in *" apps "*|*" webapps "*) "$HOME/.config/torii/bin/torii-apps" generate >/dev/null 2>&1; "$HOME/.config/torii/bin/torii-apps" webapp sync >/dev/null 2>&1 ;; esac
    say "Done"; pause ;;
  restore-helium)
    # put an earlier copy of the Helium profile back (the copies: torii-helium-backup, daily on the home server)
    name="${2:-}"; [ -n "$name" ] || { echo "usage: torii-sync restore-helium <copy name>  (see: torii-helium-backup list)"; pause; exit 2; }
    say "Restore Helium from the copy of $name"
    echo "  Helium and the web apps will be closed; the profile now here is kept in ~/.cache/torii/helium-profile-before-restore"
    echo "  (replacing the one kept from an earlier restore) and everything is opened again after."
    printf '\nContinue? [y/N] '; read -r yn; case "$yn" in y|Y) ;; *) echo "Nothing was changed."; pause; exit 0 ;; esac
    close_helium
    dst="$HOME/.cache/torii/helium-profile-before-restore"
    mkdir -p "$HOME/.cache/torii"; rm -rf "$dst"
    if [ -d "$HOME/.config/net.imput.helium" ]; then mv "$HOME/.config/net.imput.helium" "$dst"; fi
    mkdir -p "$HOME/.config/net.imput.helium"
    if rsync -a -e "ssh -o ConnectTimeout=6 -o BatchMode=yes" "equa@192.168.1.50:torii-private/snapshots/helium/$name/" "$HOME/.config/net.imput.helium/"; then
      echo "  restored"
    else
      echo "  !! copy failed, putting the old profile back"; rm -rf "$HOME/.config/net.imput.helium"; [ -d "$dst" ] && mv "$dst" "$HOME/.config/net.imput.helium"
    fi
    reopen_helium
    "$HOME/.config/torii/bin/torii-apps" webapp sync >/dev/null 2>&1
    say "Done"; pause ;;
  *) sed -n '2,13p' "$0" | sed 's/^# \?//'; exit 2 ;;
esac

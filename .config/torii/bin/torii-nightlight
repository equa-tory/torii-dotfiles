#!/usr/bin/env python3
"""torii-nightlight  -  warm screen colour through hyprsunset (GPU gamma, no overlay window).

  status                    JSON: {"on", "temp", "auto", "from", "to", "mode"}
  mode gpu|filter|overlay   gpu: hyprsunset changes the colours at the display (default)
                            filter: a Hyprland screen shader multiplies the picture by a warm colour (true dark red-amber, any GPU)
                            overlay: the shell lays a warm transparent layer over every screen (simplest, but it can only blend)
  on | off | toggle         switch now
  temp <kelvin>             1000..6500, applied at once when on
  auto <HH:MM> <HH:MM>      switch on at the first time and off at the second, every day
  auto off                  manual only
  apply                     restore after login (autostart runs this)
  dim <0..60>               filter mode only: how much darker the screen gets at full strength, in % (default 20, 0 = only the colour)
  fade <seconds>            how long the automatic fade takes (default 30, 0 = at once)
  monitor <name> <kelvin>   a monitor of its own temperature (e.g. the second one looks too dark)
  monitor <name|all> reset  that monitor (or all) follows the common temperature again
  tick                      the fade-out before the end of the window (a timer starts it)
In auto mode the colour fades in over the fade time when the window starts and fades out the same way before it
ends (about two steps a second). Manual on/off and the temperature slider act at once.
State: ~/.local/state/torii/nightlight.json. The daily switches are transient systemd user timers.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

STATE = Path(os.environ.get("TORII_STATE", Path.home() / ".local/state/torii")) / "nightlight.json"
DEFAULT = {"on": False, "temp": 4000, "auto": False, "from": "20:00", "to": "07:00", "mode": "gpu", "fade": 30, "dim": 20, "monitors": {}}
SELF = os.path.abspath(sys.argv[0])


def load():
    try:
        return {**DEFAULT, **json.loads(STATE.read_text())}
    except (OSError, ValueError):
        return dict(DEFAULT)


def save(s):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(s))
    os.replace(tmp, STATE)


def sh(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True)


def running():
    return sh("pgrep", "-x", "hyprsunset").returncode == 0


SHADERS = [STATE.with_name("nightlight-a.frag"), STATE.with_name("nightlight-b.frag")]
PIDFILE = STATE.with_name("nightlight.pid")


def shader_text(kelvin, strength=None, dim=20):
    """Multiplies the picture by a warm colour (what real night modes do): white becomes a calm dark amber-red."""
    import math
    t = kelvin / 100.0
    g = max(0.0, min(1.0, (99.4708025861 * math.log(t) - 161.1195681661) / 255)) if t > 1 else 0.0
    b = 1.0 if t >= 66 else (0.0 if t <= 19 else max(0.0, min(1.0, (138.5177312231 * math.log(t - 10) - 305.0447927307) / 255)))
    k = 1.0 - max(0, min(60, dim)) / 100.0          # how bright the screen stays at full strength (dim 20 = 0.80)
    r, g, b = k, k * g ** 2.4, k * 0.875 * b ** 3.0
    f = max(0.0, min(1.0, (6500 - kelvin) / 1500.0)) if strength is None else strength   # fade: 0 = no change, 1 = full
    r, g, b = 1 + (r - 1) * f, 1 + (g - 1) * f, 1 + (b - 1) * f
    return ("#version 300 es\nprecision highp float;\nin vec2 v_texcoord;\nuniform sampler2D tex;\n"
            "layout(location = 0) out vec4 fragColor;\nvoid main() {\n    vec4 c = texture(tex, v_texcoord);\n"
            f"    fragColor = vec4(c.rgb * vec3({r:.3f}, {g:.3f}, {b:.3f}), c.a);\n}}\n")


def set_shader(path):
    sh("hyprctl", "eval", 'hl.config({decoration={screen_shader="%s"}})' % path)


def window(s, now):
    """(start, end) datetimes of the auto window that contains `now`, or None."""
    from datetime import timedelta
    ah, am = map(int, s["from"].split(":"))
    bh, bm = map(int, s["to"].split(":"))
    day = now.replace(hour=0, minute=0, second=0, microsecond=0)
    a, b = day + timedelta(hours=ah, minutes=am), day + timedelta(hours=bh, minutes=bm)
    if a <= b:
        return (a, b) if a <= now < b else None
    if now >= a:
        return a, b + timedelta(days=1)
    if now < b:
        return a - timedelta(days=1), b
    return None


def ramp_state(s, now=None):
    """(effective kelvin, seconds until the next step). Inside an auto window the colour eases in over `fade` seconds
    after the start and eases out before the end; manual use is always the full temperature. A short wait (< 5 s)
    means the colour is still moving."""
    now = now or datetime.now()
    if not s["on"]:
        return 6500, None
    dur = float(s["fade"])
    w = window(s, now) if s["auto"] and dur > 0 else None
    if not w:
        return s["temp"], None
    f_in = (now - w[0]).total_seconds() / dur
    f_out = (w[1] - now).total_seconds() / dur
    f = max(0.0, min(1.0, min(f_in, f_out)))
    eff = round(6500 + (s["temp"] - 6500) * f)
    if f < 1:
        return eff, max(0.4, dur / 50)
    return eff, max(5, int((w[1] - now).total_seconds() - dur))       # the plateau: wake up when the way back begins


def arm_tick(seconds):
    sh("systemctl", "--user", "stop", "torii-nl-tick.timer")
    if seconds and not os.environ.get("TORII_NO_HOOKS"):
        sh("systemd-run", "--user", "--collect", "--unit=torii-nl-tick", f"--on-active={int(seconds)}s", SELF, "tick")


def outputs():
    import json as _j
    try:
        return [m["name"] for m in _j.loads(sh("hyprctl", "monitors", "-j").stdout)]
    except ValueError:
        return []


def permon(s):
    """Own temperatures per monitor: torii-ctm sets a colour matrix per output (hyprsunset can only colour every screen alike,
    and wlsunset claims every output for itself, so two of them cannot share the screens). Not in overlay mode."""
    return s["mode"] in ("gpu", "filter") and bool(s.get("monitors"))


CTM = [  # kelvin, green, blue: what hyprsunset multiplies the screen by (red is always 1), every 100 K
    (1000, 0.2664, 0.0000),
    (1100, 0.3035, 0.0000),
    (1200, 0.3375, 0.0000),
    (1300, 0.3687, 0.0000),
    (1400, 0.3976, 0.0000),
    (1500, 0.4245, 0.0000),
    (1600, 0.4497, 0.0000),
    (1700, 0.4733, 0.0000),
    (1800, 0.4956, 0.0000),
    (1900, 0.5167, 0.0000),
    (2000, 0.5367, 0.0545),
    (2100, 0.5558, 0.1063),
    (2200, 0.5739, 0.1536),
    (2300, 0.5913, 0.1970),
    (2400, 0.6079, 0.2373),
    (2500, 0.6238, 0.2748),
    (2600, 0.6391, 0.3098),
    (2700, 0.6538, 0.3428),
    (2800, 0.6680, 0.3738),
    (2900, 0.6817, 0.4032),
    (3000, 0.6949, 0.4310),
    (3100, 0.7077, 0.4576),
    (3200, 0.7201, 0.4828),
    (3300, 0.7321, 0.5070),
    (3400, 0.7437, 0.5301),
    (3500, 0.7550, 0.5523),
    (3600, 0.7660, 0.5736),
    (3700, 0.7767, 0.5941),
    (3800, 0.7871, 0.6138),
    (3900, 0.7972, 0.6329),
    (4000, 0.8071, 0.6513),
    (4100, 0.8168, 0.6691),
    (4200, 0.8262, 0.6864),
    (4300, 0.8353, 0.7031),
    (4400, 0.8443, 0.7193),
    (4500, 0.8531, 0.7350),
    (4600, 0.8616, 0.7503),
    (4700, 0.8700, 0.7652),
    (4800, 0.8782, 0.7797),
    (4900, 0.8863, 0.7938),
    (5000, 0.8942, 0.8076),
    (5100, 0.9019, 0.8210),
    (5200, 0.9095, 0.8341),
    (5300, 0.9169, 0.8469),
    (5400, 0.9242, 0.8593),
    (5500, 0.9313, 0.8716),
    (5600, 0.9384, 0.8835),
    (5700, 0.9453, 0.8952),
    (5800, 0.9521, 0.9066),
    (5900, 0.9587, 0.9178),
    (6000, 0.9653, 0.9288),
    (6100, 0.9717, 0.9395),
    (6200, 0.9781, 0.9501),
    (6300, 0.9843, 0.9604),
    (6400, 0.9905, 0.9706),
    (6500, 0.9965, 0.9806),
]


def rgb(kelvin):
    k = max(1000, min(6500, kelvin))
    i = min(len(CTM) - 2, int((k - 1000) // 100))
    (k0, g0, b0), (k1, g1, b1) = CTM[i], CTM[i + 1]
    f = (k - k0) / (k1 - k0)
    return 1.0, g0 + (g1 - g0) * f, b0 + (b1 - b0) * f


SRC = Path(__file__).resolve().parent.parent / "src"
CTM_BIN = Path(os.environ.get("TORII_CACHE", Path.home() / ".cache/torii")) / "torii-ctm"
CTM_FILE = STATE.with_name("ctm.txt")


def ctm_binary():
    """Build torii-ctm once (gcc and wayland-scanner; both come with the base packages)."""
    srcs = [SRC / "torii-ctm.c", SRC / "hyprland-ctm-control-v1.xml"]
    if CTM_BIN.exists() and CTM_BIN.stat().st_mtime >= max(p.stat().st_mtime for p in srcs):
        return True
    work = CTM_BIN.parent / "ctm-build"
    work.mkdir(parents=True, exist_ok=True)
    xml = str(SRC / "hyprland-ctm-control-v1.xml")
    steps = [["wayland-scanner", "client-header", xml, str(work / "hyprland-ctm-control-v1-client.h")],
             ["wayland-scanner", "private-code", xml, str(work / "hyprland-ctm-control-v1-protocol.c")],
             ["cc", "-O2", f"-I{work}", "-o", str(CTM_BIN), str(SRC / "torii-ctm.c"), str(work / "hyprland-ctm-control-v1-protocol.c"),
              "-lwayland-client", "-lm"]]
    return all(sh(*c).returncode == 0 for c in steps)


def push_ctm(s):
    if not s["on"]:
        sh("pkill", "-x", "torii-ctm")
        return
    if not ctm_binary():
        print("torii-nightlight: could not build torii-ctm (needs gcc and wayland)", file=sys.stderr)
        return
    base = s["temp"]
    f = max(0.0, min(1.0, (6500 - s.get("eff", base)) / max(1.0, 6500 - base)))       # 0 = faded out, 1 = full strength
    k = 1.0 - (max(0, min(60, s.get("dim", 20))) / 100.0) * f if s["mode"] == "filter" else 1.0
    lines = []
    for out in outputs():
        t = int(s["monitors"].get(out, base))
        r, g, b = rgb(round(6500 + (t - 6500) * f))
        lines.append(f"{out} {r * k:.5f} {g * k:.5f} {b * k:.5f}")
    tmp = CTM_FILE.with_suffix(".tmp")
    tmp.write_text("\n".join(lines) + "\n")
    os.replace(tmp, CTM_FILE)
    if sh("pgrep", "-x", "torii-ctm").returncode != 0:
        sh("pkill", "-x", "hyprsunset")                 # one program at a time owns the colour matrices
        time.sleep(0.2)
        cmd = [str(CTM_BIN), str(CTM_FILE)]
        subprocess.Popen(["uwsm", "app", "--"] + cmd if shutil.which("uwsm") else cmd,
                         stdout=subprocess.DEVNULL, stderr=open(STATE.with_name("nightlight-ctm.log"), "w"), start_new_session=True)


def push(s):
    if os.environ.get("TORII_NO_HOOKS"):
        return
    eff = s.get("eff", s["temp"])
    if permon(s):
        set_shader("")
        sh("pkill", "-x", "wlsunset")
        push_ctm(s)
        return
    sh("pkill", "-x", "torii-ctm")
    sh("pkill", "-x", "wlsunset")
    if s["mode"] != "filter":
        set_shader("")                            # nothing else may keep a shader on the screen
    if s["mode"] == "filter":
        if running():
            sh("hyprctl", "hyprsunset", "identity")
        if s["on"]:
            # two files in turn: Hyprland only reloads a shader when the path changes
            target = SHADERS[int(datetime.now().timestamp() * 2) % 2]
            strength = max(0.0, min(1.0, (6500 - eff) / max(1.0, 6500 - s["temp"])))
            tmp = target.with_suffix(".tmp")
            tmp.write_text(shader_text(s["temp"], strength, s.get("dim", 20)))
            os.replace(tmp, target)
            set_shader(str(target))
        else:
            set_shader("")
        return
    if s["mode"] == "overlay":                    # the shell draws it; make sure the GPU side is neutral
        if running():
            sh("hyprctl", "hyprsunset", "identity")
        return
    if not running():
        if not s["on"]:
            return
        subprocess.Popen(["uwsm", "app", "--", "hyprsunset"] if sh("which", "uwsm").returncode == 0 else ["hyprsunset"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        for _ in range(30):
            if running():
                break
            subprocess.run(["sleep", "0.1"])
        subprocess.run(["sleep", "0.3"])
    if s["on"]:
        sh("hyprctl", "hyprsunset", "temperature", str(min(6500, eff)))
    else:
        sh("hyprctl", "hyprsunset", "identity")


def timers(s):
    for unit in ("torii-nl-on", "torii-nl-off"):
        sh("systemctl", "--user", "stop", unit + ".timer")
    if os.environ.get("TORII_NO_HOOKS") or not s["auto"]:
        return
    for unit, when, verb in (("torii-nl-on", s["from"], "on"), ("torii-nl-off", s["to"], "off")):
        sh("systemd-run", "--user", "--collect", "--timer-property=AccuracySec=1s", f"--unit={unit}", f"--on-calendar=*-*-* {when}:00", SELF, verb)


def in_window(s):
    now = datetime.now().strftime("%H:%M")
    a, b = s["from"], s["to"]
    return (a <= now < b) if a <= b else (now >= a or now < b)


def valid_time(t):
    return bool(re.fullmatch(r"([01]\d|2[0-3]):[0-5]\d", t))


def main(a):
    s = load()
    cmd = a[0] if a else "status"
    if cmd == "status":
        print(json.dumps(s))
        return
    if cmd in ("on", "off", "toggle"):
        s["on"] = (not s["on"]) if cmd == "toggle" else cmd == "on"
    elif cmd == "temp" and len(a) == 2 and a[1].isdigit() and 1000 <= int(a[1]) <= 6500:
        s["temp"] = int(a[1])
    elif cmd == "fade" and len(a) == 2 and a[1].isdigit() and int(a[1]) <= 3600:
        s["fade"] = int(a[1])
    elif cmd == "dim" and len(a) == 2 and a[1].isdigit() and int(a[1]) <= 60:
        s["dim"] = int(a[1])
    elif cmd == "monitor" and len(a) == 3 and (a[2] == "reset" or (a[2].isdigit() and 1000 <= int(a[2]) <= 6500)):
        mons = dict(s.get("monitors") or {})
        if a[2] == "reset":
            mons = {} if a[1] == "all" else {k: v for k, v in mons.items() if k != a[1]}
        else:
            mons[a[1]] = int(a[2])
        s["monitors"] = mons
    elif cmd == "mode" and len(a) == 2 and a[1] in ("gpu", "filter", "overlay"):
        s["mode"] = a[1]
    elif cmd == "auto" and a[1:] == ["off"]:
        s["auto"] = False
    elif cmd == "auto" and len(a) == 3 and valid_time(a[1]) and valid_time(a[2]):
        s.update({"auto": True, "from": a[1], "to": a[2]})
        s["on"] = in_window(s)
    elif cmd == "apply":
        if s["auto"]:
            s["on"] = in_window(s)
    elif cmd == "tick":
        if s["auto"] and not in_window(s):
            s["on"] = False
    else:
        print(__doc__)
        sys.exit(2)
    stop_fade()
    s["eff"], wait = ramp_state(s)
    save(s)
    push(s)
    if wait is not None and wait < 5 and not os.environ.get("TORII_NO_HOOKS"):
        PIDFILE.write_text(str(os.getpid()))
        while wait is not None and wait < 5:
            time.sleep(wait)
            s = load()
            s["eff"], wait = ramp_state(s)
            save(s)
            push(s)
        PIDFILE.unlink(missing_ok=True)
    arm_tick(wait)
    if cmd != "tick":
        timers(s)


def stop_fade():
    """A newer command takes over from a fade that is still running."""
    try:
        pid = int(PIDFILE.read_text())
        if pid != os.getpid() and b"torii-nightlight" in Path(f"/proc/{pid}/cmdline").read_bytes():
            os.kill(pid, 15)
        PIDFILE.unlink(missing_ok=True)
    except (OSError, ValueError):
        pass


if __name__ == "__main__":
    main(sys.argv[1:])

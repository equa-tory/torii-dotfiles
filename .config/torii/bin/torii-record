#!/usr/bin/env python3
"""torii-record toggle | audio | apps | monitor on|off|toggle  -  screen recording with sound (torii-capture record runs this).

  audio    start recording sound only (no picture) as a WAV in ~/Music/Recordings, or stop and save the one that runs; what is
           recorded is capture.audio (Capture > Audio recording): programs (e.g. "Helium" for an online class in the browser),
           the microphone, what the computer plays, and `folder` for one file per source instead of one mixed file.
           A program that is not playing yet is recorded from the moment it starts, and again each time it restarts
           (the gaps stay silent, so the recording keeps its real length).

  toggle   start recording the focused monitor, or stop it (and save) when one is running
  apps     JSON list of the programs that play sound now, for the per-app choice
  monitor  hear your own microphone in the speakers (a loopback), to set its volume before recording; it stops at the start of a
           recording and by itself after two minutes

What is recorded comes from capture.rec in ~/.config/torii/config.json (Capture > Screen recording in the launcher):
  system  true    what the computer plays (the default output)
  mic     true    the default microphone, with `micGain` (1.0 = as it is) applied to the recording only
  apps    []      names of programs (as `apps` shows them); each one gets its own track, e.g. ["Deadlock", "Discord"]
  lanes   true    every sound source is its own audio track in the file (switch tracks in the player or editor);
                  false mixes them into one track
  folder  false   a folder ~/Videos/<time>/ with video.mp4 (everything mixed) and one audio file per source (system.flac,
                  mic.flac, ...); false is a single file ~/Videos/<time>.mp4
The picture comes from wf-recorder, each sound from pw-record into a temporary file; ffmpeg puts them together when you stop
(video is copied, not encoded again). A program that starts playing after the recording began is not in it.
"""
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
STATE = Path(os.environ.get("TORII_STATE", HOME / ".local/state/torii"))
FLAG = STATE / "recording.json"          # the notch shows a red dot while "on" is true
PID = STATE / "recording.pid"
MON = STATE / "mic-monitor.json"
VIDEOS = Path(os.environ.get("XDG_VIDEOS_DIR", HOME / "Videos"))
DEFAULTS = {"system": True, "mic": True, "apps": [], "lanes": True, "folder": False, "micGain": 1.0}
AUDIO_DEFAULTS = {"system": False, "mic": False, "apps": [], "folder": False, "micGain": 1.0}
MUSIC = Path(os.environ.get("XDG_MUSIC_DIR", HOME / "Music")) / "Recordings"


def note(title, body=""):
    subprocess.run(["notify-send", "-a", "torii", title, body], capture_output=True)


def cfg():
    out = subprocess.run([str(HOME / ".config/torii/bin/torii-config"), "get", "capture.rec"], capture_output=True, text=True).stdout
    try:
        c = json.loads(out)
    except ValueError:
        c = None
    return {**DEFAULTS, **(c if isinstance(c, dict) else {})}


def acfg():
    out = subprocess.run([str(HOME / ".config/torii/bin/torii-config"), "get", "capture.audio"], capture_output=True, text=True).stdout
    try:
        c = json.loads(out)
    except ValueError:
        c = None
    return {**AUDIO_DEFAULTS, **(c if isinstance(c, dict) else {})}


def write_flag(on, **extra):
    STATE.mkdir(parents=True, exist_ok=True)
    FLAG.write_text(json.dumps({"on": on, **extra}) + "\n")


def inspect(target, key):
    out = subprocess.run(["wpctl", "inspect", target], capture_output=True, text=True).stdout
    m = re.search(r'^\s*\*?\s*' + re.escape(key) + r' = "([^"]*)"', out, re.M)
    return m.group(1) if m else ""


def webapp_names():
    """pid of a browser process that only has web app windows -> the name of the (first) web app."""
    try:
        clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=3).stdout)
        apps = json.loads((STATE / "webapps.json").read_text())
    except (OSError, ValueError, subprocess.SubprocessError):
        return {}
    from urllib.parse import urlparse
    by_class = {}
    for w in apps:
        u = urlparse(w["url"] if "://" in w["url"] else "https://" + w["url"])
        by_class[f"chrome-{u.hostname}_{(u.path or '/').replace('/', '_')}-Default"] = w["name"]
    pids = {}
    for c in clients:
        pids.setdefault(c.get("pid"), []).append(c.get("class") or "")
    return {pid: by_class[cl[0]] for pid, cl in pids.items() if cl and all(x in by_class for x in cl)}


def sound_apps():
    """name -> [node ids] of programs that play sound now. A web app that has a browser process of its own (Install > Web app
    and TUI options > own process) shows by its name; the ordinary browser (and web apps in it) is one "Helium"."""
    webs = webapp_names()
    try:
        dump = json.loads(subprocess.run(["pw-dump"], capture_output=True, text=True, timeout=5).stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        return {}
    apps = {}
    for o in dump:
        p = (o.get("info") or {}).get("props") or {}
        if o.get("type") != "PipeWire:Interface:Node" or p.get("media.class") != "Stream/Output/Audio":
            continue
        name = p.get("application.name") or p.get("application.process.binary") or p.get("node.name") or ""
        if p.get("application.process.id") in webs:
            name = webs[p["application.process.id"]] + " (web app)"
        if name and not name.lower().startswith("torii"):
            apps.setdefault(name, []).append(o["id"])
    return apps


def focused_monitor():
    out = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True).stdout
    return next((m["name"] for m in json.loads(out) if m.get("focused")), "")


def safe(name):
    return re.sub(r"[^A-Za-z0-9._-]+", "_", name).strip("_") or "app"


# ------------------------------------------------------------------ hear the microphone
def monitor(arg):
    cur = None
    try:
        cur = json.loads(MON.read_text()).get("module")
    except (OSError, ValueError):
        pass
    on = (cur is None) if arg == "toggle" else arg == "on"
    if cur is not None:
        subprocess.run(["pactl", "unload-module", str(cur)], capture_output=True)
        MON.unlink(missing_ok=True)
    if on:
        src = inspect("@DEFAULT_AUDIO_SOURCE@", "node.name")
        r = subprocess.run(["pactl", "load-module", "module-loopback", f"source={src}", "sink=@DEFAULT_SINK@", "latency_msec=40"],
                           capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip().isdigit():
            MON.parent.mkdir(parents=True, exist_ok=True)
            MON.write_text(json.dumps({"module": int(r.stdout.strip())}))
            subprocess.Popen(["sh", "-c", f"sleep 120; pactl unload-module {int(r.stdout.strip())} 2>/dev/null; rm -f {MON}"],
                             start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ------------------------------------------------------------------ record
def running():
    try:
        pid = int(PID.read_text())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return 0


def record():
    c = cfg()
    if not shutil.which("wf-recorder"):
        note("torii-record", "wf-recorder is not installed")
        return
    monitor("off")
    STATE.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y-%m-%d_%H-%M-%S")
    tmp = HOME / ".cache/torii-rec" / stamp
    tmp.mkdir(parents=True, exist_ok=True)
    VIDEOS.mkdir(parents=True, exist_ok=True)
    stop = []
    signal.signal(signal.SIGINT, lambda *_: stop.append(1))
    signal.signal(signal.SIGTERM, lambda *_: stop.append(1))
    PID.write_text(str(os.getpid()))

    video = tmp / "video.mkv"
    wf = subprocess.Popen(["wf-recorder", "-o", focused_monitor(), "-f", str(video)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(150):                      # sound starts as soon as the recorder has opened its file (the picture follows within
        if video.exists() or wf.poll() is not None:     # a tenth of a second; the file itself stays empty for a few seconds)
            break
        time.sleep(0.02)

    tracks, procs = [], []                    # (label, wav file, is_mic)

    def pw(label, target, wav, props=None, is_mic=False):
        cmd = ["pw-record", "--rate", "48000", "--channels", "2", "--target", str(target)]
        if props:
            cmd += ["-P", props]
        procs.append(subprocess.Popen(cmd + [str(wav)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
        tracks.append((label, wav, is_mic))

    if c["system"]:
        pw("System", inspect("@DEFAULT_AUDIO_SINK@", "node.name"), tmp / "system.wav", "stream.capture.sink=true")
    if c["mic"]:
        pw("Microphone", inspect("@DEFAULT_AUDIO_SOURCE@", "node.name"), tmp / "mic.wav", None, True)
    apps = sound_apps()
    missing = []
    for want in c["apps"]:
        ids = apps.get(want)
        if not ids:
            missing.append(want)
            continue
        pw(want, ids[0], tmp / f"app-{safe(want)}.wav", "stream.capture.sink=true")      # without it a program's stream records as silence

    write_flag(True, start=int(time.time()))
    note("Recording started", "Click the red dot in the notch to stop" + ("  ·  not playing now: " + ", ".join(missing) if missing else ""))
    while wf.poll() is None and not stop:
        time.sleep(0.2)

    for p in procs:
        p.send_signal(signal.SIGINT)
    if wf.poll() is None:
        wf.send_signal(signal.SIGINT)
    for p in procs + [wf]:
        try:
            p.wait(timeout=15)
        except subprocess.TimeoutExpired:
            p.kill()
    write_flag(False)
    PID.unlink(missing_ok=True)
    if not video.exists() or video.stat().st_size == 0:
        note("Recording failed", "No picture was recorded")
        shutil.rmtree(tmp, ignore_errors=True)
        return
    note("Saving the recording…")
    out = mux(c, tmp, video, [t for t in tracks if t[1].exists() and t[1].stat().st_size > 1000], stamp)
    shutil.rmtree(tmp, ignore_errors=True)
    note("Recording saved", str(out) if out else "ffmpeg failed; the pieces are in " + str(tmp))


# ------------------------------------------------------------------ audio only
def audio_record():
    c = acfg()
    wanted = list(c["apps"])
    if not (c["system"] or c["mic"] or wanted):
        note("Nothing to record", "Pick a program, the microphone or the computer's sound in Capture > Audio recording")
        return
    monitor("off")
    STATE.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y-%m-%d_%H-%M-%S")
    tmp = HOME / ".cache/torii-rec" / ("audio-" + stamp)
    tmp.mkdir(parents=True, exist_ok=True)
    stop = []
    signal.signal(signal.SIGINT, lambda *_: stop.append(1))
    signal.signal(signal.SIGTERM, lambda *_: stop.append(1))
    PID.write_text(str(os.getpid()))
    t0 = time.time()
    segs = []                                  # {label, wav, at, mic, proc, node}

    def start(label, target, wav, props=None, is_mic=False, node=None):
        cmd = ["pw-record", "--rate", "48000", "--channels", "2", "--target", str(target)]
        if props:
            cmd += ["-P", props]
        segs.append({"label": label, "wav": wav, "at": time.time() - t0, "mic": is_mic, "node": node,
                     "proc": subprocess.Popen(cmd + [str(wav)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)})

    if c["system"]:
        start("System", inspect("@DEFAULT_AUDIO_SINK@", "node.name"), tmp / "system.wav", "stream.capture.sink=true")
    if c["mic"]:
        start("Microphone", inspect("@DEFAULT_AUDIO_SOURCE@", "node.name"), tmp / "mic.wav", None, True)
    write_flag(True, start=int(time.time()), audio=True)
    note("Audio recording started", "Click the red dot in the notch to stop" + ("  ·  waiting for " + ", ".join(wanted) + " to play" if wanted else ""))

    count = {}
    last = 0.0
    while not stop:
        time.sleep(0.2)
        if not wanted or time.time() - last < 1.0:
            continue
        last = time.time()
        now = sound_apps()
        for name in wanted:
            cur = next((s for s in reversed(segs) if s["label"] == name and s["proc"].poll() is None), None)
            ids = now.get(name) or []
            if cur is not None and cur["node"] not in ids:          # the program stopped playing: close this piece
                cur["proc"].send_signal(signal.SIGINT)
                cur = None
            if cur is None and ids:
                count[name] = count.get(name, 0) + 1
                start(name, ids[0], tmp / f"app-{safe(name)}-{count[name]}.wav", "stream.capture.sink=true", node=ids[0])

    for s in segs:
        if s["proc"].poll() is None:
            s["proc"].send_signal(signal.SIGINT)
    for s in segs:
        try:
            s["proc"].wait(timeout=15)
        except subprocess.TimeoutExpired:
            s["proc"].kill()
    total = time.time() - t0
    write_flag(False)
    PID.unlink(missing_ok=True)
    good = [s for s in segs if s["wav"].exists() and s["wav"].stat().st_size > 1000]
    if not good:
        note("Nothing was recorded", ("No sound from " + ", ".join(wanted) + " (it has to play sound)") if wanted else "No sound came in")
        shutil.rmtree(tmp, ignore_errors=True)
        return
    note("Saving the recording…")
    MUSIC.mkdir(parents=True, exist_ok=True)
    out = mux_audio(c, good, stamp, total)
    shutil.rmtree(tmp, ignore_errors=True)
    note("Audio saved", str(out) if out else "ffmpeg failed; the pieces are in " + str(tmp))


def mix_wav(segs, out, gain, total):
    """One WAV from pieces placed at their real time (silence in between), padded to the whole length."""
    inputs, chains = [], []
    for i, s in enumerate(segs):
        inputs += ["-i", str(s["wav"])]
        ms = int(s["at"] * 1000)
        f = f"[{i}:a]"
        if s["mic"] and abs(gain - 1.0) > 0.01:
            f += f"volume={gain:.2f},"
        chains.append(f"{f}adelay={ms}|{ms}[a{i}]")
    n = len(segs)
    if n == 1:
        mix = "[a0]anull[aout]"
    else:
        mix = "".join(f"[a{i}]" for i in range(n)) + f"amix=inputs={n}:normalize=0:duration=longest[aout]"
    return ff(inputs + ["-filter_complex", ";".join(chains + [mix]), "-map", "[aout]", "-t", f"{total:.2f}", "-c:a", "pcm_s16le", str(out)])


def mux_audio(c, segs, stamp, total):
    gain = float(c["micGain"])
    if c["folder"]:
        d = MUSIC / stamp
        d.mkdir(parents=True, exist_ok=True)
        labels = sorted({s["label"] for s in segs})
        ok = all(mix_wav([s for s in segs if s["label"] == l], d / f"{safe(l.lower())}.wav", gain, total) for l in labels)
        return d if ok else None
    out = MUSIC / f"{stamp}.wav"
    return out if mix_wav(segs, out, gain, total) else None


def ff(args):
    return subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-nostdin"] + args, capture_output=True, text=True).returncode == 0


def gain_chain(i, label, is_mic, gain, out):
    f = f"[{i}:a]"
    if is_mic and abs(gain - 1.0) > 0.01:
        f += f"volume={gain:.2f}"
    else:
        f += "anull"
    return f"{f}[{out}]"


def mux(c, tmp, video, tracks, stamp):
    gain = float(c["micGain"])
    n = len(tracks)
    inputs = ["-i", str(video)]
    for _, wav, _ in tracks:
        inputs += ["-i", str(wav)]
    if c["folder"]:
        d = VIDEOS / stamp
        d.mkdir(parents=True, exist_ok=True)
        for i, (label, wav, is_mic) in enumerate(tracks, 1):
            af = [] if not (is_mic and abs(gain - 1.0) > 0.01) else ["-af", f"volume={gain:.2f}"]
            ff(["-i", str(wav)] + af + [str(d / f"{safe(label.lower())}.flac")])
        out = d / "video.mp4"
        if n == 0:
            ok = ff(["-i", str(video), "-c", "copy", str(out)])
        else:
            chains = [gain_chain(i, l, m, gain, f"a{i}") for i, (l, _, m) in enumerate(tracks, 1)]
            mix = "".join(f"[a{i}]" for i in range(1, n + 1)) + f"amix=inputs={n}:normalize=0:duration=longest[aout]" if n > 1 else "[a1]anull[aout]"
            ok = ff(inputs + ["-filter_complex", ";".join(chains + [mix]), "-map", "0:v", "-map", "[aout]", "-c:v", "copy", "-c:a", "aac", "-b:a", "192k", str(out)])
        return d if ok else None
    out = VIDEOS / f"{stamp}.mp4"
    if n == 0:
        return out if ff(["-i", str(video), "-c", "copy", str(out)]) else None
    chains = [gain_chain(i, l, m, gain, f"a{i}") for i, (l, _, m) in enumerate(tracks, 1)]
    if c["lanes"] or n == 1:
        maps = []
        for i, (label, _, _) in enumerate(tracks, 1):
            maps += ["-map", f"[a{i}]", f"-metadata:s:a:{i - 1}", f"title={label}"]
        args = inputs + ["-filter_complex", ";".join(chains), "-map", "0:v"] + maps
    else:
        mix = "".join(f"[a{i}]" for i in range(1, n + 1)) + f"amix=inputs={n}:normalize=0:duration=longest[aout]"
        args = inputs + ["-filter_complex", ";".join(chains + [mix]), "-map", "0:v", "-map", "[aout]"]
    return out if ff(args + ["-c:v", "copy", "-c:a", "aac", "-b:a", "192k", str(out)]) else None


def main(a):
    if a == ["toggle"]:
        pid = running()
        if pid:
            os.kill(pid, signal.SIGINT)
        else:
            record()
    elif a == ["audio"]:
        pid = running()
        if pid:
            os.kill(pid, signal.SIGINT)
        else:
            audio_record()
    elif a == ["apps"]:
        print(json.dumps([{"name": n} for n in sorted(sound_apps(), key=str.lower)]))
    elif len(a) == 2 and a[0] == "monitor" and a[1] in ("on", "off", "toggle"):
        monitor(a[1])
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])

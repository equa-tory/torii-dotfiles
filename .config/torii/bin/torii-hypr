#!/usr/bin/env python3
"""torii-hypr layout <dwindle|master|scrolling> | gaps <inner> <outer> | sensitivity <-1..1>
            | size <percent> | float <toggle|status> | bars height <px> | bars side <left|right>
            | border <0..10> | scale <monitor> <factor> | mode <monitor> <WxH@Hz> | monitors | opacity <0.3..1> | blur <on|off> | blur <size> <passes> <vibrancy> | status | apply

Runtime choices made from the launcher. They are kept in ~/.local/state/torii/hypr-user.json, applied to the running
Hyprland at once and re-applied at every start through hypr-user.lua (hyprland.lua loads it last).
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

STATE = Path(os.environ.get("TORII_STATE", Path.home() / ".local/state/torii"))
JS, LUA = STATE / "hypr-user.json", STATE / "hypr-user.lua"
LAYOUTS = ("dwindle", "master", "scrolling")


def load():
    try:
        return json.loads(JS.read_text())
    except (OSError, ValueError):
        return {}


def lua(s):
    general, decoration, inp = [], [], ""
    if "layout" in s:
        general.append(f'layout="{s["layout"]}"')
    if "gaps_in" in s:
        general.append(f'gaps_in={int(s["gaps_in"])}, gaps_out={int(s["gaps_out"])}')
    if "border" in s:
        general.append(f'border_size={int(s["border"])}')
    if "opacity" in s:
        decoration.append(f'active_opacity={float(s["opacity"])}, inactive_opacity={float(s["opacity"])}')
    if "blur" in s:
        b = s["blur"]
        decoration.append("blur={enabled=%s, size=%d, passes=%d, vibrancy=%s}" % (
            "true" if b.get("enabled", True) else "false", int(b.get("size", 3)), int(b.get("passes", 1)), float(b.get("vibrancy", 0.17))))
    if "sens" in s:
        inp = "input={sensitivity=%s}" % float(s["sens"])
    tables = [t for t in (
        "general={%s}" % ", ".join(general) if general else "",
        "decoration={%s}" % ", ".join(decoration) if decoration else "", inp) if t]
    out = "hl.config({%s})\n" % ", ".join(tables) if tables else ""
    for name, m in s.get("scale", {}).items():
        if float(m["scale"]) == 1.0 and not m.get("custom"):   # the default: no need to modeset the monitor again at every start
            continue
        out += 'hl.monitor({ output = "%s", mode = "%s", position = "%s", scale = %s })\n' % (name, m["mode"], m["pos"], m["scale"])
    return out or "-- nothing chosen yet\n"


def save(s):
    STATE.mkdir(parents=True, exist_ok=True)
    for path, text in ((JS, json.dumps(s)), (LUA, lua(s))):
        tmp = path.with_suffix(path.suffix + ".tmp")
        tmp.write_text(text)
        os.replace(tmp, path)


def apply(s):
    if not os.environ.get("TORII_NO_HOOKS") and s:
        for line in lua(s).strip().splitlines():
            subprocess.run(["hyprctl", "eval", line], capture_output=True)


def live_sensitivity():
    try:
        out = subprocess.run(["hyprctl", "getoption", "input:sensitivity", "-j"], capture_output=True, text=True, timeout=3).stdout
        return float(json.loads(out).get("float", 0.0))
    except (OSError, ValueError, subprocess.SubprocessError):
        return 0.0


def monitors():
    try:
        out = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=3).stdout
        return json.loads(out)
    except (OSError, ValueError, subprocess.SubprocessError):
        return []


def valid_scales(w, h):
    return [c / 20 for c in range(10, 61)
            if all(abs(v / (c / 20) - round(v / (c / 20))) < 0.01 for v in (w, h))]


def short_modes(m):
    """availableModes like 1920x1080@60.00Hz -> [(1920, 1080, 60.0)] without duplicates, largest first"""
    seen, out = set(), []
    for t in m.get("availableModes", []):
        r = re.match(r"(\d+)x(\d+)@([\d.]+)", t)
        if r:
            key = (int(r.group(1)), int(r.group(2)), round(float(r.group(3))))
            if key not in seen:
                seen.add(key)
                out.append(key)
    out.sort(key=lambda k: (-k[0] * k[1], -k[2]))
    return out


def set_mode(s, name, mode):
    cur = next((m for m in monitors() if m["name"] == name), None)
    mt = re.fullmatch(r"(\d+)x(\d+)@(\d+(?:\.\d+)?)", mode)
    if not cur or not mt:
        print("no such monitor or mode", file=sys.stderr)
        sys.exit(1)
    old = s.get("scale", {}).get(name, {})
    scale = old.get("scale", cur["scale"])
    w, h = int(mt.group(1)), int(mt.group(2))
    ok = valid_scales(w, h)
    if ok and scale not in ok:
        scale = min(ok, key=lambda c: abs(c - scale))      # keep a scale this resolution can carry
    spec = {"mode": mode, "pos": "%dx%d" % (cur["x"], cur["y"]), "scale": scale, "custom": True}
    if not os.environ.get("TORII_NO_HOOKS"):
        subprocess.run(["hyprctl", "eval", 'hl.monitor({ output = "%s", mode = "%s", position = "%s", scale = %s })' % (name, mode, spec["pos"], scale)], capture_output=True)
    s.setdefault("scale", {})[name] = spec
    relayout(s)


def set_scale(s, name, factor):
    """Scale one monitor. Hyprland silently keeps the old scale when the factor leaves a fractional logical size,
    so the factor snaps to the nearest one that divides the resolution into whole pixels (1896x1003 only allows 1)."""
    cur = next((m for m in monitors() if m["name"] == name), None)
    if not cur:
        print("no such monitor", file=sys.stderr)
        sys.exit(1)
    old = s.get("scale", {}).get(name)
    ok = valid_scales(cur["width"], cur["height"])
    if ok:
        factor = min(ok, key=lambda c: abs(c - factor))
    spec = {"mode": "%dx%d@%.2f" % (cur["width"], cur["height"], cur["refreshRate"]), "pos": "%dx%d" % (cur["x"], cur["y"]), "scale": factor}
    if old and old.get("custom"):
        spec["custom"] = True
    if not os.environ.get("TORII_NO_HOOKS"):
        subprocess.run(["hyprctl", "eval", 'hl.monitor({ output = "%s", mode = "%s", position = "%s", scale = %s })' % (name, spec["mode"], spec["pos"], factor)], capture_output=True)
        after = next((m for m in monitors() if m["name"] == name), None)
        if after and abs(after["scale"] - float(factor)) > 0.01:
            print("Hyprland refused scale %s" % factor, file=sys.stderr)
            sys.exit(1)
    s.setdefault("scale", {})[name] = spec if old is None or old != spec else old
    relayout(s)


def relayout(s):
    """Monitors side by side from left to right: after a scale or resolution change the logical widths differ, and without this
    a gap (or an overlap) appears between them and the mouse cannot cross."""
    mons = sorted(monitors(), key=lambda m: (m["x"], m["y"]))
    x = 0
    for m in mons:
        spec = s.setdefault("scale", {}).get(m["name"]) or {"mode": "%dx%d@%.2f" % (m["width"], m["height"], m["refreshRate"]), "scale": m["scale"]}
        width = int(re.match(r"(\d+)x", spec["mode"]).group(1))
        pos = "%dx%d" % (x, m["y"])
        if spec.get("pos") != pos or not spec.get("custom"):
            spec = dict(spec, pos=pos, custom=True)
            s["scale"][m["name"]] = spec
            if not os.environ.get("TORII_NO_HOOKS"):
                subprocess.run(["hyprctl", "eval", 'hl.monitor({ output = "%s", mode = "%s", position = "%s", scale = %s })' % (m["name"], spec["mode"], pos, spec["scale"])], capture_output=True)
        x += round(width / float(spec["scale"]))


FLOAT_LUA, BARS_LUA = STATE / "floatmode.lua", STATE / "bars.lua"


def float_mode():
    try:
        return "float" if 'mode = "float"' in FLOAT_LUA.read_text() else "tile"
    except OSError:
        return "tile"


def big_percent():
    try:
        m = re.search(r"percent\s*=\s*(\d+)", (STATE / "windowsize.lua").read_text())
        return int(m.group(1)) if m else 70
    except OSError:
        return 70


def bars():
    out = {"height": 28, "side": "right"}
    try:
        t = BARS_LUA.read_text()
        m = re.search(r"height\s*=\s*(\d+)", t)
        if m:
            out["height"] = int(m.group(1))
        if re.search(r'side\s*=\s*"left"', t):
            out["side"] = "left"
    except OSError:
        pass
    return out


def set_bars(key, value):
    b = bars()
    b[key] = value
    STATE.mkdir(parents=True, exist_ok=True)
    BARS_LUA.write_text('return { height = %d, side = "%s" }\n' % (b["height"], b["side"]))
    if os.environ.get("TORII_NO_HOOKS"):
        return
    if key == "height":
        subprocess.run(["hyprctl", "eval", "hl.config({ plugin = { hyprbars = { bar_height = %d } } })" % b["height"]], capture_output=True)
    else:
        subprocess.run(["hyprctl", "reload"], capture_output=True)      # the buttons are added again on the other side


def main(a):
    s = load()
    if a[:2] == ["float", "toggle"]:
        subprocess.run(["hyprctl", "eval", "torii_float_toggle()"], capture_output=True)
        return
    if a[:2] == ["float", "status"]:
        print(float_mode())
        return
    if a[:1] == ["size"] and len(a) == 2 and a[1].isdigit():
        STATE.mkdir(parents=True, exist_ok=True)
        (STATE / "windowsize.lua").write_text("return { percent = %d }\n" % max(30, min(100, int(a[1]))))
        return
    if a[:2] == ["bars", "height"] and len(a) == 3 and a[2].isdigit():
        set_bars("height", max(16, min(64, int(a[2]))))
        return
    if a[:2] == ["bars", "side"] and len(a) == 3 and a[2] in ("left", "right"):
        set_bars("side", a[2])
        return
    if a[:1] == ["monitors"]:
        print(json.dumps([{"name": m["name"], "scale": m["scale"], "w": m["width"], "h": m["height"], "hz": round(m["refreshRate"]),
                           "desc": m.get("description", ""), "scales": valid_scales(m["width"], m["height"]),
                           "modes": ["%dx%d@%d" % k for k in short_modes(m)[:14]]} for m in monitors()]))
        return
    if a[:1] == ["status"]:
        cur = {"layout": "dwindle", "gaps_in": 8, "gaps_out": 20, "border": 1, "sens": live_sensitivity(), "opacity": 1.0,
               "blur": {"enabled": True, "size": 3, "passes": 1, "vibrancy": 0.17},
               "float": float_mode(), "bars": bars(), "bigPercent": big_percent()}
        print(json.dumps({**cur, **s}))
        return
    if a[:1] == ["layout"] and len(a) == 2 and a[1] in LAYOUTS:
        s["layout"] = a[1]
    elif a[:1] == ["gaps"] and len(a) == 3 and a[1].isdigit() and a[2].isdigit():
        s["gaps_in"], s["gaps_out"] = int(a[1]), int(a[2])
    elif a[:1] == ["sensitivity"] and len(a) == 2:
        v = max(-1.0, min(1.0, round(float(a[1]), 2)))
        s["sens"] = v
    elif a[:1] == ["mode"] and len(a) == 3:
        set_mode(s, a[1], a[2])
    elif a[:1] == ["scale"] and len(a) == 3:
        set_scale(s, a[1], float(a[2]))
    elif a[:1] == ["border"] and len(a) == 2 and a[1].isdigit():
        s["border"] = max(0, min(10, int(a[1])))
    elif a[:1] == ["opacity"] and len(a) == 2:
        s["opacity"] = max(0.3, min(1.0, round(float(a[1]), 2)))
    elif a[:2] == ["blur", "on"] or a[:2] == ["blur", "off"]:
        s["blur"] = dict(s.get("blur", {}), enabled=a[1] == "on")
    elif a[:1] == ["blur"] and len(a) == 4:
        s["blur"] = dict(s.get("blur", {}), size=int(a[1]), passes=int(a[2]), vibrancy=round(float(a[3]), 2))
    elif a[:1] == ["apply"]:
        apply(s)
        return
    else:
        print(__doc__)
        sys.exit(2)
    save(s)
    apply(s)


if __name__ == "__main__":
    main(sys.argv[1:])

#!/usr/bin/env python3
"""torii-sound reminder|notification  -  play the sound set in config.json ("sounds": {"reminder", "notification", "volume"}).

A name is looked up in ~/.config/torii/sounds/ (drop your own files there; a missing file falls back to the freedesktop
sound theme), an absolute path is used as it is. Notifications stay silent while do not disturb is on; reminders do not.
"""
import json
import os
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
THEME = Path("/usr/share/sounds/freedesktop/stereo")
FALLBACK = {"reminder": "complete.oga", "notification": "message.oga"}


def read(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def main(kind):
    if kind not in FALLBACK:
        print(__doc__)
        sys.exit(2)
    state = Path(os.environ.get("TORII_STATE", HOME / ".local/state/torii"))
    if kind == "notification" and read(state / "notifications.json").get("dnd"):
        return
    cfg = read(HOME / ".config/torii/config.json").get("sounds", {})
    name = cfg.get(kind, f"{kind}.oga")
    candidates = []
    if name:
        p = Path(os.path.expanduser(name))
        candidates.append(p if p.is_absolute() else HOME / ".config/torii/sounds" / name)
    candidates.append(THEME / FALLBACK[kind])
    for f in candidates:
        if f.is_file():
            vol = max(0.0, min(1.0, float(cfg.get("volume", 0.8))))
            subprocess.Popen(["pw-play", "--volume", str(vol), str(f)], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
            return


if __name__ == "__main__":
    main(sys.argv[1] if len(sys.argv) > 1 else "")

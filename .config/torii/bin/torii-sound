#!/usr/bin/env python3
"""torii-sound reminder|notification  -  play the sound set in config.json ("sounds": {"reminder", "notification", "volume"}).

Looked up in this order: the name set in config.json (a file in ~/.config/torii/sounds/, or an absolute path), then any
~/.config/torii/sounds/<kind>.* (ogg, oga, wav, mp3, flac), then the freedesktop sound theme. Notifications stay silent
while do not disturb is on; reminders do not. `torii-sound list` prints the files in the sounds folder (JSON) and
`torii-sound play <file>` plays one (the launcher's preview).
"""
import json
import os
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
THEME = Path("/usr/share/sounds/freedesktop/stereo")
FALLBACK = {"reminder": "complete.oga", "notification": "message.oga"}


def read(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


SOUNDS = HOME / ".config/torii/sounds"
EXT = (".ogg", ".oga", ".wav", ".mp3", ".flac")


def play(f, vol):
    subprocess.Popen(["pw-play", "--volume", str(vol), str(f)], stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def volume(cfg):
    return max(0.0, min(1.0, float(cfg.get("volume", 0.8))))


def find(kind, name):
    if name:
        p = Path(os.path.expanduser(name))
        yield p if p.is_absolute() else SOUNDS / name
    for ext in EXT:
        yield SOUNDS / (kind + ext)
    yield THEME / FALLBACK[kind]


def main(kind, arg=None):
    cfg = read(HOME / ".config/torii/config.json").get("sounds", {})
    if kind == "list":
        print(json.dumps(sorted(p.name for p in SOUNDS.glob("*") if p.suffix.lower() in EXT)) if SOUNDS.is_dir() else "[]")
        return
    if kind == "play" and arg:
        p = Path(os.path.expanduser(arg))
        f = p if p.is_absolute() else SOUNDS / arg
        if f.is_file():
            play(f, volume(cfg))
        return
    if kind not in FALLBACK:
        print(__doc__)
        sys.exit(2)
    state = Path(os.environ.get("TORII_STATE", HOME / ".local/state/torii"))
    if kind == "notification" and read(state / "notifications.json").get("dnd"):
        return
    for f in find(kind, cfg.get(kind, "")):
        if f.is_file():
            play(f, volume(cfg))
            return
    print(f"torii-sound: no {kind} sound found (put one in {SOUNDS})", file=sys.stderr)


if __name__ == "__main__":
    main(*(sys.argv[1:3] or [""]))

# Shared by zsh and bash (sourced from ~/.zshrc / ~/.bashrc).

# ==============================
# EDITOR: the one the user chose in Setup > Defaults (uwsm env), else nvim, vim, nano
# ==============================
if [ -z "$EDITOR" ]; then
  for _e in nvim vim nano; do
    command -v "$_e" &>/dev/null && { EDITOR="$_e"; break; }
  done
  unset _e
fi
export EDITOR="${EDITOR:-vi}" VISUAL="${VISUAL:-$EDITOR}"

if command -v sudo &>/dev/null; then
  SUDO="sudo"
else
  SUDO=""
fi

# Use a widely available terminal definition for SSH from Kitty/Ghostty.
# Scope TERM to the SSH process; preserve screen/tmux and other terminal types.
# `command ssh ...` bypasses this compatibility wrapper when needed.
ssh() {
  case "${TERM:-}" in
    xterm-kitty|xterm-ghostty|ghostty)
      TERM=xterm-256color command ssh "$@"
      ;;
    *) command ssh "$@" ;;
  esac
}


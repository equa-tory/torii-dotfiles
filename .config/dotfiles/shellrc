sedit() {
  if [[ -z "$1" ]]; then
    echo "Usage: sedit <service>"
    return 1
  fi
  $SUDO ${EDITOR} "/etc/systemd/system/${1}.service" && $SUDO systemctl daemon-reload
}

srestart() {
  $SUDO systemctl restart "$1" && $SUDO systemctl status "$1"
}


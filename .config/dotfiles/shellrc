# Find the local xray HTTP proxy (ports vary by host/config).
_xray_proxy_url() {
  local p fd
  zmodload zsh/net/tcp 2>/dev/null || { print -u2 "cannot load zsh TCP support to check xray proxy"; return 1; }
  for p in 10808 1080; do
    if ztcp 127.0.0.1 $p 2>/dev/null; then
      fd=$REPLY
      ztcp -c $fd 2>/dev/null
      REPLY="http://127.0.0.1:$p"
      return 0
    fi
  done
  print -u2 "xray proxy unavailable: neither 127.0.0.1:10808 nor 127.0.0.1:1080 is accepting connections"
  return 1
}

# Claude Code through the local xray proxy
claude-xray() {
  local proxy
  _xray_proxy_url || return 1
  proxy=$REPLY
  HTTPS_PROXY=$proxy HTTP_PROXY=$proxy https_proxy=$proxy http_proxy=$proxy \
  NO_PROXY="" claude "$@"
}
alias cx=codex-xray

# Codex through the local xray proxy
codex-xray() {
  local proxy
  _xray_proxy_url || return 1
  proxy=$REPLY
  HTTPS_PROXY=$proxy HTTP_PROXY=$proxy https_proxy=$proxy http_proxy=$proxy \
  NO_PROXY="" codex "$@"
}

# Update Codex through the local xray proxy
codex-update() {
  local proxy prefix
  local -a elevate
  _xray_proxy_url || return 1
  proxy=$REPLY
  prefix=$(npm prefix -g) || return 1
  elevate=()
  if [ ! -w "$prefix" ] || { [ -d "$prefix/lib/node_modules" ] && [ ! -w "$prefix/lib/node_modules" ]; }; then
    elevate=(sudo)
  fi
  "${elevate[@]}" env HTTPS_PROXY="$proxy" HTTP_PROXY="$proxy" https_proxy="$proxy" http_proxy="$proxy" \
    NO_PROXY="" no_proxy="" npm install -g @openai/codex --proxy="$proxy" --https-proxy="$proxy" "$@"
}
alias cx-update=codex-update


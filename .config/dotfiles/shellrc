# Shared by zsh and bash (sourced from ~/.zshrc / ~/.bashrc).

# ==============================
# EDITOR: the one the user chose in Setup > Defaults (uwsm env), else nvim, vim, nano
# ==============================
if [ -z "$EDITOR" ]; then
  for _e in nvim vim nano; do
    command -v "$_e" &>/dev/null && { EDITOR="$_e"; break; }
  done
  unset _e
fi
export EDITOR="${EDITOR:-vi}" VISUAL="${VISUAL:-$EDITOR}"

if command -v sudo &>/dev/null; then
  SUDO="sudo"
else
  SUDO=""
fi

# ==============================
# PYTHON
# ==============================
alias py='python3'
alias vnv='source venv/bin/activate'
alias vnvv='python3 -m venv venv && source venv/bin/activate'
alias deac='deactivate'

# ==============================
# DOCKER  d
# ==============================
d() {
  local cmd="$1"; shift
  case "$cmd" in
    # Containers
    ps)          docker ps "$@" ;;
    up)          docker compose up -d "$@" ;;
    down)        docker compose down "$@" ;;
    build)       docker compose build "$@" ;;
    start)       $SUDO docker start "$@" ;;
    stop)        $SUDO docker stop "$@" ;;
    rm)          docker rm -f "$@" ;;
    # Images
    pull)        docker pull "$@" ;;
    rmi)         docker rmi "$@" ;;
    images)      docker images "$@" ;;
    # Exec / logs
    sh)          docker exec -it "$1" bash ;;
    logs)        docker logs -f "$@" ;;
    # Run: d run <image> [extra flags]
    run)
      local image="$1"; shift
      local name="${image%%:*}"
      docker run -d --name "$name" "$@" "$image"
      ;;
    *)           echo "d [ps|up|down|build|start|stop|rm|pull|rmi|images|sh|logs|run]"; return 1 ;;
  esac
}


port() { $SUDO lsof -i :"$1"; }

# Claude Code through the local xray proxy
claude-xray() {
  HTTPS_PROXY="http://127.0.0.1:10808" HTTP_PROXY="http://127.0.0.1:10808" \
  https_proxy="http://127.0.0.1:10808" http_proxy="http://127.0.0.1:10808" \
  NO_PROXY="" claude "$@"
}
alias cx='claude-xray'


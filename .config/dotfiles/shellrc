export PATH="$HOME/.local/bin:$HOME/.config/torii/bin:$PATH"

# a server that does not know our terminal (e.g. xterm-kitty over ssh) breaks clear, tmux, nvim: use a common one instead
if [ -n "$TERM" ] && command -v infocmp >/dev/null 2>&1 && ! infocmp "$TERM" >/dev/null 2>&1; then
  export TERM=xterm-256color
fi

c

command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init "${SHELL##*/}" --cmd cd)"
if [ -n "$ZSH_VERSION" ] && command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh 2>/dev/null) 2>/dev/null
fi

# open FILE: video / audio / pictures / pdf / text / json / code / databases / .exe with the right app, asks when none is set
# (torii-open --list shows them, open -c FILE chooses again). On macOS the system `open` stays.
[ "$(uname)" = Linux ] && command -v torii-open >/dev/null 2>&1 && alias open='torii-open'

# y: file manager in the terminal (yazi). Arrows / h j k l move, Enter opens (through `open`), q leaves and cd's to where you were.
y() {
  command -v yazi >/dev/null 2>&1 || { echo "yazi is not installed"; return 1; }
  local tmp cwd; tmp="$(mktemp -t yazi-cwd.XXXXXX)"
  yazi "$@" --cwd-file="$tmp"
  cwd="$(cat -- "$tmp" 2>/dev/null)"; rm -f -- "$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && cd -- "$cwd"
}

# gdu: skips network shares below the folder (gdu /mnt took ages walking the Samba shares) and reads a spinning disk one file at a time
command -v torii-gdu >/dev/null 2>&1 && alias gdu='torii-gdu'
